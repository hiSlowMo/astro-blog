---
import StatusBadge from '@/components/StatusBadge.astro'
import { allLocales, themeConfig } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath, getPostPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'
import { formatPostDate } from '@/utils/date'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag },
      props: { tag },
    }))
  }))
  return paths.flat()
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const posts = await getPostsByTag(tag, currentLang)
const supportedLangs = await getTagSupportedLangs(tag)
---

<Layout pageTitle={`标签：${tag}`} pageDescription={`浏览「${tag}」相关的 ${posts.length} 篇文章，来自 SlowMo's 办事处。`} supportedLangs={supportedLangs}>
  <header class="tag-detail-header">
    <a class="tag-detail-all" href={getLocalizedPath('/tags/', currentLang)}><span aria-hidden="true">←</span> 全部标签</a>
    <div class="tag-detail-heading">
      <h1 class="page-title">{tag}</h1>
      <span class="tag-total font-time"><strong>{posts.length}</strong> 篇</span>
    </div>
  </header>

  <!-- Posts List -->
  <section class="tag-detail-posts" aria-label={`标签「${tag}」的文章`}>
    <ul class="tag-post-list">
      {posts.map((post) => {
        const slug = post.data.abbrlink || post.id
        const date = post.data.published
        return (
          <li class="tag-post">
            <time class="tag-post-date font-time" datetime={date.toISOString()}>{formatPostDate(date, themeConfig.global.dateFormat)}</time>
            <div class="tag-post-title">
              <a
                class="module-title entry-link"
                href={getPostPath(slug, currentLang)}
                transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
                data-disable-theme-toggle-transition
              >
                {post.data.title}
              </a>
              {post.data.status && <StatusBadge status={post.data.status} />}
            </div>
            <span class="tag-post-reading font-time" lang="en">{post.remarkPluginFrontmatter.minutes}min</span>
          </li>
        )
      })}
    </ul>
  </section>
</Layout>

<style>
  .tag-detail-header {
    display: grid;
    justify-items: start;
    gap: .75rem;
    padding-bottom: .85rem;
    border-bottom: var(--section-divider);
  }

  .tag-detail-heading {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .tag-detail-heading h1 {
    overflow-wrap: anywhere;
  }

  .tag-total {
    padding: .25rem .55rem .3rem 1rem;
    mask-image: var(--cut-start);
    background: var(--text-meta, oklch(var(--un-preset-theme-colors-primary)));
    color: oklch(var(--un-preset-theme-colors-background));
    font-size: .8rem;
    line-height: 1;
    white-space: nowrap;
  }

  .tag-total strong {
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }

  .tag-detail-all {
    flex: none;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.9);
    font-size: 0.95rem;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .tag-detail-all:hover {
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .tag-detail-all:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }

  .tag-post-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-post {
    display: grid;
    grid-template-columns: var(--editorial-index) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--editorial-gap);
    padding-block: .85rem;
    border-bottom: var(--section-divider);
  }

  .tag-post-date,
  .tag-post-reading {
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.85);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .tag-post-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.65rem;
    min-width: 0;
  }

  .tag-post-title a {
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--motion-fast) ease;
  }

  .tag-post-title :global(.status-badge) {
    font-size: 0.8125rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.85);
  }

  .tag-post-title :global(.status-hint) {
    inset-inline: auto 100%;
  }

  .tag-post-title a:hover {
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .tag-post-title a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }

  @media (max-width: 639px) {
    .tag-post {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: .3rem .75rem;
    }

    .tag-post-title {
      grid-area: 1 / 1 / 2 / -1;
    }

    .tag-post-date,
    .tag-post-reading {
      font-size: .8rem;
    }
  }

  :global(html.reduce-motion) .tag-detail-all,
  :global(html.reduce-motion) .tag-post-title a {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-detail-all,
    .tag-post-title a {
      transition: none;
    }
  }
</style>
