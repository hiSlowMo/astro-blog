---
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsGroupByTags } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const allTags = await getAllTags(currentLang)
const postsByTag = await getPostsGroupByTags(currentLang)
const tagCounts = Object.fromEntries(
  [...postsByTag.entries()].map(([tag, posts]) => [tag, posts.length]),
)
---

<Layout pageTitle={ui[currentLang].tags} pageDescription={`按主题浏览 SlowMo 的文章，共 ${allTags.length} 个标签。`}>
  <section class="tag-overview" aria-labelledby="tag-overview-title">
    <header class="tag-overview-header">
      <div>
        <h1 class="section-label" id="tag-overview-title">{ui[currentLang].tags} <small lang="en">TAGS</small></h1>
        <p>同一篇文字，也可以有不同的入口。</p>
      </div>
      <span class="topic-total font-time"><strong>{allTags.length}</strong> <small lang="en">TOPICS</small></span>
    </header>
    <TagList
      indexLayout
      tags={allTags}
      lang={currentLang}
      counts={tagCounts}
    />
  </section>
</Layout>

<style>
  .tag-overview-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .75rem;
    padding-bottom: 1rem;
    border-bottom: var(--section-divider);
  }

  .tag-overview-header p {
    margin: 0.65rem 0 0;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.85);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .topic-total {
    flex: none;
    display: flex;
    align-items: flex-end;
    gap: .35rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
  }

  .topic-total strong {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 6vw, 4.4rem);
    line-height: .88;
    letter-spacing: -.055em;
  }

  .topic-total small {
    writing-mode: vertical-rl;
    font-size: .68rem;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  @media (max-width: 480px) {
    .topic-total {
      flex-direction: column;
    }

    .topic-total small {
      writing-mode: horizontal-tb;
    }
  }
</style>
