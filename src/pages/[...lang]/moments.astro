---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const allMoments = await getCollection(
  'moments',
  ({ data }: CollectionEntry<'moments'>) => import.meta.env.DEV || !data.draft,
)
const moments = allMoments.sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
)
const renderedMoments = await Promise.all(
  moments.map(async (moment) => {
    const { Content } = await render(moment)
    return { moment, Content }
  }),
)

function formatMomentDate(date: Date) {
  const parts = new Intl.DateTimeFormat('en-CA', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Shanghai',
  }).formatToParts(date)

  const get = (type: string) => parts.find(p => p.type === type)?.value ?? ''
  return `${get('year')}-${get('month')}-${get('day')} ${get('hour')}:${get('minute')}`
}
---

<Layout
  pageTitle={currentUI.moments}
  pageDescription={currentUI.momentsIntro}
  enableContentEnhancements
>
  <div class="uno-decorative-line" />

  <div class="moments-header">
    <p class="moments-intro">{currentUI.momentsIntro}</p>
    {moments.length > 0 && (
      <p class="moments-count font-time">
        {currentUI.momentsCount.replace('{COUNT}', String(moments.length))}
      </p>
    )}
  </div>

  {moments.length === 0
    ? (
        <p class="mt-6 c-secondary">{currentUI.momentsEmpty}</p>
      )
    : (
        <ul class="moments-list">
          {renderedMoments.map(({ moment, Content }) => (
            <li id={`moment-${moment.id}`} class="moment-card">
              <div class="no-heti moment-content">
                <Content />
              </div>

              <div class="moment-footer font-time">
                {moment.data.tags && moment.data.tags.length > 0 && (
                  <div class="moment-tags">
                    {moment.data.tags.map((tag: string) => (
                      <span class="moment-tag">#{tag}</span>
                    ))}
                  </div>
                )}
                <time class="moment-time" datetime={moment.data.published.toISOString()}>
                  {formatMomentDate(moment.data.published)}
                </time>
              </div>
            </li>
          ))}
        </ul>
      )}

  <style is:inline>
    .moments-header {
      margin-top: 0.8rem;
      padding-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      border-bottom: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.16);
    }

    .moments-intro {
      font-size: 0.9rem;
      line-height: 1.6;
      color: oklch(var(--un-preset-theme-colors-secondary) / 0.88);
    }

    .moments-count {
      flex-shrink: 0;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: oklch(var(--un-preset-theme-colors-secondary) / 0.72);
      font-variant-numeric: tabular-nums;
    }

    .moments-list {
      margin-top: 1.35rem;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }

    .moment-card {
      position: relative;
      padding: 0.85rem 1.15rem 0.75rem;
      background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.025);
      scroll-margin-top: 4rem;
      transition: background-color 180ms ease;
    }

    .moment-card:hover {
      background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.045);
    }

    /* Corner brackets (┌ ┐ └ ┘) at rest -> full 1px frame on hover / focus-within */
    .moment-card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      --corner-color: oklch(var(--un-preset-theme-colors-secondary) / 0.48);
      background-image:
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color));
      background-position:
        0 0,
        0 0,
        100% 0,
        100% 0,
        0 100%,
        0 100%,
        100% 100%,
        100% 100%;
      background-size:
        8px 1px,
        1px 8px,
        8px 1px,
        1px 8px,
        8px 1px,
        1px 8px,
        8px 1px,
        1px 8px;
      background-repeat: no-repeat;
      transition:
        background-size 220ms var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
        opacity 180ms ease;
    }

    .moment-card:hover::before,
    .moment-card:focus-within::before {
      --corner-color: oklch(var(--un-preset-theme-colors-primary) / 0.65);
      background-size:
        50% 1px,
        1px 50%,
        50% 1px,
        1px 50%,
        50% 1px,
        1px 50%,
        50% 1px,
        1px 50%;
    }

    .moment-content {
      font-size: 0.9375rem;
      line-height: 1.72;
      color: oklch(var(--un-preset-theme-colors-primary) / 0.95);
      text-align: left !important;
      text-justify: none !important;
      letter-spacing: normal !important;
    }

    .moment-content p {
      margin: 0.3em 0;
      line-height: 1.72;
      color: oklch(var(--un-preset-theme-colors-primary) / 0.95);
      text-align: left !important;
      text-justify: none !important;
      letter-spacing: normal !important;
      word-break: break-word;
    }

    .moment-content p:first-child {
      margin-top: 0;
    }

    .moment-content p:last-child {
      margin-bottom: 0;
    }

    .moment-footer {
      margin-top: 0.55rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 0.4rem 0.75rem;
      font-size: 0.8125rem;
      line-height: 1.4;
      color: oklch(var(--un-preset-theme-colors-secondary) / 0.72);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }

    .moment-tags {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
    }

    .moment-tag {
      opacity: 0.85;
    }

    .moment-time {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .moment-time::before {
      content: '—';
      opacity: 0.5;
    }

    @media (max-width: 640px) {
      .moment-card {
        padding: 0.75rem 0.88rem 0.65rem;
      }
      .moment-content {
        font-size: 0.9rem;
      }
      .moments-list {
        gap: 0.95rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .moment-card,
      .moment-card::before {
        transition: none;
      }
    }

    html.reduce-motion .moment-card,
    html.reduce-motion .moment-card::before {
      transition: none;
    }
  </style>
</Layout>
