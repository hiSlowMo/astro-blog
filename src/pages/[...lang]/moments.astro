---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { siteTimeZone } from '@/utils/calendar.mjs'
import { formatPostDate } from '@/utils/date'
import { hasMathContent } from '@/utils/math'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const allMoments = await getCollection(
  'moments',
  ({ data }: CollectionEntry<'moments'>) => import.meta.env.DEV || !data.draft,
)
const moments = allMoments.sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
)
const hasMath = moments.some(moment => hasMathContent(moment.body, moment.filePath))
const renderedMoments = await Promise.all(
  moments.map(async (moment) => {
    const { Content } = await render(moment)
    return { moment, Content }
  }),
)

const clockFormat = new Intl.DateTimeFormat('en-GB', {
  hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: siteTimeZone,
})
---

<Layout
  pageTitle={currentUI.moments}
  pageDescription={currentUI.momentsIntro}
  enableContentEnhancements
  enableKatex={hasMath}
>
  <header class="moments-header">
    <div class="moments-heading">
      <h2 class="section-label">{currentUI.moments} <small lang="en">MOMENTS</small></h2>
      <p class="moments-count font-time">
        {currentUI.momentsCount.replace('{COUNT}', String(moments.length))}
      </p>
    </div>
    <p class="moments-intro">{currentUI.momentsIntro}</p>
  </header>

  {moments.length === 0
    ? (
        <p class="mt-6 c-secondary">{currentUI.momentsEmpty}</p>
      )
    : (
        <ul class="moments-list">
          {renderedMoments.map(({ moment, Content }, index) => {
            const date = moment.data.published
            const [month, day] = formatPostDate(date, 'MMM D').split(' ')
            const year = formatPostDate(date, 'YYYY-MM-DD').slice(0, 4)
            const clock = clockFormat.format(date)
            const timestamp = `${formatPostDate(date, 'MMM D YYYY')} · ${clock}`
            return (
            <li id={`moment-${moment.id}`} class:list={['moment-card', { 'moment-lead': index === 0 }]} tabindex="0">
              {index === 0 && (
                <time class="moment-dateline font-time" datetime={moment.data.published.toISOString()} aria-label={timestamp}>
                  <span>{month}</span>
                  <strong>{day}</strong>
                  <span>{year} · {clock}</span>
                </time>
              )}
              <div class="no-heti moment-content">
                <Content />
              </div>

              {(index > 0 || !!moment.data.tags?.length) && (
<div class="moment-footer font-time">
                {moment.data.tags && moment.data.tags.length > 0 && (
                  <div class="moment-tags">
                    {moment.data.tags.map((tag: string) => (
                      <span class="moment-tag">#{tag}</span>
                    ))}
                  </div>
                )}
                {index > 0 && (
<time class="moment-time" datetime={moment.data.published.toISOString()}>
                  {timestamp}
                </time>
)}
              </div>
)}
            </li>
            )
          })}
        </ul>
      )}

  <style is:inline>
    .moments-header {
      padding-bottom: 0.75rem;
      border-bottom: var(--section-divider);
    }

    .moments-heading {
      display: flex;
      align-items: baseline;
      gap: .65rem;
      justify-content: space-between;
    }

    .moments-intro {
      margin-top: .4rem;
      font-size: 0.9rem;
      line-height: 1.6;
      color: oklch(var(--un-preset-theme-colors-secondary) / 0.88);
    }

    .moments-count, .moment-footer {
      font-size: .85rem;
      line-height: 1.5;
      color: var(--text-meta, oklch(var(--un-preset-theme-colors-secondary)));
    }

    .moments-count {
      flex-shrink: 0;
    }

    .moments-list {
      margin-top: 1rem;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .9rem;
    }

    .moment-card {
      position: relative;
      padding: .7rem clamp(.75rem, 2vw, 1rem) .65rem;
      background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.025);
      scroll-margin-top: 4rem;
      transition: background-color var(--motion-fast) ease;
    }

    .moment-card:hover, .moment-card:focus-within {
      background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.045);
    }

    .moment-card:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }

    /* Corner brackets (┌ ┐ └ ┘) at rest -> full 1px frame on hover / focus-within */
    .moment-card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      --corner-color: oklch(var(--un-preset-theme-colors-secondary) / 0.48);
      background-image:
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color)),
        linear-gradient(var(--corner-color), var(--corner-color));
      background-position:
        0 0,
        0 0,
        100% 0,
        100% 0,
        0 100%,
        0 100%,
        100% 100%,
        100% 100%;
      background-size:
        8px 1px,
        1px 8px,
        8px 1px,
        1px 8px,
        8px 1px,
        1px 8px,
        8px 1px,
        1px 8px;
      background-repeat: no-repeat;
      transition:
        background-size var(--motion-base) var(--motion-ease-standard),
        opacity var(--motion-fast) ease;
    }

    .moment-card:hover::before,
    .moment-card:focus-within::before {
      --corner-color: oklch(var(--un-preset-theme-colors-primary) / 0.65);
      background-size:
        50% 1px,
        1px 50%,
        50% 1px,
        1px 50%,
        50% 1px,
        1px 50%,
        50% 1px,
        1px 50%;
    }

    .moment-content {
      font-size: 1rem;
      line-height: 1.75;
      color: oklch(var(--un-preset-theme-colors-primary) / 0.95);
      text-align: left !important;
      text-justify: none !important;
      letter-spacing: normal !important;
    }

    .moment-content p {
      margin: 0.3em 0;
      line-height: inherit;
      color: oklch(var(--un-preset-theme-colors-primary) / 0.95);
      text-align: left !important;
      text-justify: none !important;
      letter-spacing: normal !important;
      word-break: break-word;
    }

    .moment-content p:first-child {
      margin-top: 0;
    }

    .moment-content p:last-child {
      margin-bottom: 0;
    }

    .moment-footer {
      margin-top: .4rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 0.4rem 0.75rem;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }

    .moment-tags {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
    }

    .moment-tag {
      opacity: 0.85;
    }

    .moment-time {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .moment-time::before {
      content: '—';
      opacity: 0.5;
    }

    .moment-lead {
      display: grid;
      grid-template-columns: var(--editorial-index) minmax(0, 1fr);
      column-gap: var(--editorial-gap);
      align-content: center;
    }

    .moment-dateline {
      grid-row: 1 / span 2;
      align-self: start;
      display: grid;
      justify-items: start;
      padding: .65rem .85rem;
      background: var(--text-meta, oklch(var(--un-preset-theme-colors-primary)));
      color: oklch(var(--un-preset-theme-colors-background));
      font-size: .75rem;
      font-variant-numeric: tabular-nums;
      mask-image: var(--cut-end);
    }

    .moment-dateline strong {
      font: 700 2.75rem/1 var(--font-mono);
      letter-spacing: -.05em;
    }

    .moment-lead .moment-content {
      grid-column: 2;
      align-self: center;
      font-size: 1.1rem;
    }

    .moment-lead .moment-footer {
      grid-column: 2;
      justify-content: flex-start;
    }

    @media (max-width: 640px) {
      .moment-lead {
        display: block;
      }

      .moment-dateline {
        display: inline-flex;
        align-items: baseline;
        gap: .45rem;
        margin-bottom: .65rem;
        padding: .25rem 1rem .25rem .55rem;
      }

      .moment-dateline strong {
        font-size: 1.5rem;
      }

      .moments-list {
        gap: .75rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .moment-card,
      .moment-card::before {
        transition: none;
      }
    }

    html.reduce-motion .moment-card,
    html.reduce-motion .moment-card::before {
      transition: none;
    }
  </style>
</Layout>
