---
import AlbumEntry from '@/components/Records/AlbumEntry.astro'
import RecordCover from '@/components/Records/RecordCover.astro'
import SectionHeading from '@/components/Records/SectionHeading.astro'
import { allLocales } from '@/config'
import { friendLinks, websiteLinks } from '@/data/friend-links'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import RecordLayout from '@/layouts/RecordLayout.astro'
import { getPageInfo } from '@/utils/page'
import { COLLECTION_PREVIEW_LIMIT, formatRecordDate, getNewArrivals, getSpinningCandidates, padNumber } from '@/utils/records'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const { getLocalizedPath } = getPageInfo(Astro.url.pathname)
const submitHref = getLocalizedPath('/links/submit/')

// Tracks are picked by hand in src/data/friend-links.ts; nothing is fetched at build time
const albums = friendLinks
// Every real track is a candidate; the browser picks one per visit (see the script below the list)
const spinning = getSpinningCandidates(albums)
const spinShells = albums.filter(album => !album.tracks?.length)
  .map(album => ({ album, track: { title: '', url: '', date: '', excerpt: '' } }))
const newArrivals = getNewArrivals(albums)
const shelf = albums.slice(0, COLLECTION_PREVIEW_LIMIT)
const backroom = albums.slice(COLLECTION_PREVIEW_LIMIT)
const catalogYear = new Date().getFullYear()

// Section numbers follow whichever sections are on the page
const sectionKeys = [
  albums.length > 0 && 'spinning',
  newArrivals.length > 0 && 'arrivals',
  'collection',
].filter(Boolean) as string[]
const sectionNo = (key: string) => padNumber(sectionKeys.indexOf(key) + 1)
---

<RecordLayout
  pageTitle={`${currentUI.links} · THE SLOWMO RECORDS`}
  pageDescription="THE SLOWMO RECORDS：SlowMo 收录的独立创作者个人网站。每个站点像一张专辑，有自己的封面，也有持续更新的曲目。"
>
  <div class="records-page">
    <!-- Masthead -->
    <section class="masthead rec-fade" aria-labelledby="records-title">
      <div class="masthead__brand">
        <h1 class="masthead__title" id="records-title">THE SLOWMO RECORDS</h1>
        <p class="masthead__tagline">A RECORD STORE FOR THE INDEPENDENT WEB.</p>
      </div>

      <dl class="masthead__meta">
        <div>
          <dt class="rec-label">CATALOG <span class="masthead__slash" aria-hidden="true">/</span></dt>
          <dd class="rec-value">{catalogYear}</dd>
        </div>
        <div>
          <dt class="rec-label">CURATED BY <span class="masthead__slash" aria-hidden="true">/</span></dt>
          <dd class="rec-value">SLOWMO</dd>
        </div>
        <div>
          <dt class="rec-label">RECORDS <span class="masthead__slash" aria-hidden="true">/</span></dt>
          <dd class="rec-value">{padNumber(albums.length)}</dd>
        </div>
      </dl>

      <div class="masthead__body">
        <div class="masthead__intro">
          <p>这排唱片架上，每张专辑都是一个独立博客。</p>
          <p>点开封面，去作者家坐坐。也可以从一篇文章读起，让随机选曲带路。</p>
        </div>
        <div class="masthead__submit">
          <p class="rec-label">SUBMIT AN ALBUM</p>
          <a class="masthead__cta" href={submitHref}>
            推荐一张专辑 <span class="rec-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Now Spinning -->
    {albums.length > 0 && (
      <section class="spinning rec-fade" hidden={!spinning.length} aria-labelledby="now-spinning" style="--fade-delay: 60ms">
        <SectionHeading no={sectionNo('spinning')} title="Now Spinning" caption="随机选曲" id="now-spinning">
          <span class="rec-label" lang="en">SHUFFLE ON</span>
        </SectionHeading>
        <div class="spinning__deck" data-spinning>
          {[...spinning, ...spinShells].map((item, index) => (
            <article class="spinning__body" data-album={item.album.catalogNo} data-spin={item.track.url} hidden={index > 0 || !item.track.url}>
              <a
                class="spinning__cover"
                href={item.track.url}
                target="_blank"
                rel="noopener"
                tabindex="-1"
                aria-hidden="true"
                data-umami-event="outbound-link-click"
                data-umami-event-url={item.track.url}
              >
                <RecordCover album={item.album} eager />
              </a>
              <h3 class="spinning__title">
                <a
                  class="rec-link"
                  href={item.track.url}
                  target="_blank"
                  rel="noopener"
                  data-umami-event="outbound-link-click"
                  data-umami-event-url={item.track.url}
                >
                  {item.track.title}
                </a>
              </h3>
              <p class="spinning__excerpt" hidden={!item.track.excerpt}>{item.track.excerpt}</p>
              <div class="spinning__foot">
                <p class="rec-label spinning__meta">
                  <span>FROM</span>
                  <a class="rec-link spinning__album" href={`#record-${item.album.catalogNo}`}>{item.album.name}</a>
                  {item.album.artist && (
                    <>
                      <span class="spinning__sep" aria-hidden="true">/</span>
                      <span class="spinning__artist">{item.album.artist}</span>
                    </>
                  )}
                  <span class="spinning__sep" data-date-sep hidden={!item.track.date} aria-hidden="true">/</span>
                  <time hidden={!item.track.date} datetime={item.track.date}>{formatRecordDate(item.track.date)}</time>
                </p>
                <a
                  class="rec-action spinning__read"
                  href={item.track.url}
                  target="_blank"
                  rel="noopener"
                  data-umami-event="outbound-link-click"
                  data-umami-event-url={item.track.url}
                >
                  READ TRACK <span class="rec-arrow" aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
        <script is:inline data-astro-rerun>
          // Pick one real track per visit, and not the one shown last time
          (function () {
            const deck = document.querySelector('[data-spinning]')
            const items = deck ? Array.from(deck.querySelectorAll('[data-spin]:not([data-spin=""])')) : []
            if (items.length < 2)
              return
            const key = 'slowmo-records:last-spin'
            let last = null
            try {
              last = sessionStorage.getItem(key)
            }
            catch {}
            const fresh = items.filter(el => el.dataset.spin !== last)
            const pool = fresh.length ? fresh : items
            const pick = pool[Math.floor(Math.random() * pool.length)]
            items.forEach((el) => {
              el.hidden = el !== pick
            })
            try {
              sessionStorage.setItem(key, pick.dataset.spin)
            }
            catch {}
          })()
        </script>
      </section>
    )}

    <!-- New Arrivals: only once the collection is too long to take in at a glance -->
    {newArrivals.length > 0 && (
      <section class="records-section arrivals-section rec-fade" aria-labelledby="new-arrivals" style="--fade-delay: 120ms">
        <SectionHeading no={sectionNo('arrivals')} title="New Arrivals" caption="新近上架" id="new-arrivals" />
        <ol class="arrivals" style={`--arrival-count: ${newArrivals.length}`}>
          {newArrivals.map(album => (
            <li>
              <a
                class="arrival"
                href={album.url}
                target="_blank"
                rel="noopener"
                data-umami-event="outbound-link-click"
                data-umami-event-url={album.url}
              >
                <RecordCover album={album} class="arrival__cover" />
                <span class="arrival__text">
                  <span class="arrival__name">{album.name}</span>
                  <span class="rec-label arrival__meta">
                    NO. {album.catalogNo}
                    {album.addedAt && (
                      <>
                        <span aria-hidden="true"> / </span>
                        <time datetime={album.addedAt}>{formatRecordDate(album.addedAt)}</time>
                      </>
                    )}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- The Collection -->
    <section class="records-section collection-section rec-fade" aria-labelledby="the-collection" style="--fade-delay: 120ms">
      <SectionHeading no={sectionNo('collection')} title="The Collection" caption="唱片目录" id="the-collection">
        <p class="rec-label">{padNumber(albums.length)} RECORDS</p>
      </SectionHeading>

      {albums.length === 0
        ? <p class="records-empty">{currentUI.linksEmpty}</p>
        : (
            <div class="collection">
              {shelf.map(album => <AlbumEntry album={album} />)}
            </div>
          )}

      {backroom.length > 0 && (
        <details class="collection__more">
          <summary class="collection__toggle rec-action">
            <span class="collection__toggle-closed">展开更多 · {padNumber(backroom.length)} RECORDS</span>
            <span class="collection__toggle-open">收起</span>
          </summary>
          <div class="collection">
            {backroom.map(album => <AlbumEntry album={album} />)}
          </div>
        </details>
      )}

      {websiteLinks.length > 0 && (
        <div class="crate">
          <p class="rec-label">FROM THE CRATE <span class="crate__note">/ 常用网站</span></p>
          <ul class="crate__list">
            {websiteLinks.map(link => (
              <li>
                <a
                  class="crate__item"
                  href={link.url}
                  target="_blank"
                  rel="noopener"
                  data-umami-event="outbound-link-click"
                  data-umami-event-url={link.url}
                >
                  <span class="crate__name">{link.name}</span>
                  {link.description && <span class="crate__desc">{link.description}</span>}
                  <span class="rec-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>
</RecordLayout>

<script>
import '@/scripts/records-page'
import '@/scripts/records-tracks'
</script>

<style>
  /* ── Page grid ────────────────────────────────────────── */
  .records-page {
    --section-gap: clamp(1.25rem, 2.6vw, 1.875rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'mast'
      'spin'
      'arrv'
      'coll';
  }

  .masthead { grid-area: mast; }
  .spinning { grid-area: spin; }
  .arrivals-section { grid-area: arrv; }
  .collection-section { grid-area: coll; }

  /* ── Masthead ─────────────────────────────────────────── */
  .masthead {
    padding-bottom: clamp(1rem, 2vw, 1.35rem);
    border-bottom: 1px solid var(--rec-rule);
  }

  .masthead__brand {
    padding-bottom: clamp(0.75rem, 1.6vw, 1.1rem);
    text-align: center;
  }

  .masthead__title {
    margin: 0;
    color: var(--rec-ink);
    font-family: var(--rec-serif);
    font-size: clamp(2rem, 0.9rem + 3.8vw, 3.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .masthead__tagline {
    margin: 0.55rem 0 0;
    color: var(--rec-muted);
    font-family: var(--rec-mono);
    font-size: clamp(0.6875rem, 0.64rem + 0.15vw, 0.75rem);
    line-height: 1.7;
    letter-spacing: 0.32em;
    text-wrap: balance;
  }

  .masthead__meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    padding: 0.55rem 0;
    border-top: 1px solid var(--rec-rule);
    border-bottom: 1px solid var(--rec-rule);
  }

  .masthead__meta > div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .masthead__meta > div:nth-child(2) {
    align-items: center;
    text-align: center;
  }

  .masthead__meta > div:nth-child(3) {
    align-items: flex-end;
    text-align: right;
  }

  .masthead__meta dd {
    margin: 0;
  }

  .masthead__meta dt {
    white-space: nowrap;
  }

  /* Phones stack label over value, where the slash has nothing to divide */
  .masthead__slash {
    display: none;
  }

  /* Introduction, then the way in for a new album */
  .masthead__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    margin-top: clamp(0.85rem, 1.6vw, 1.15rem);
  }

  .masthead__intro {
    max-width: 38rem;
    color: var(--rec-ink-2);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .masthead__intro p {
    margin: 0;
  }

  .masthead__intro p + p {
    margin-top: 0.3rem;
  }

  .masthead__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rec-hair);
  }

  .masthead__submit .rec-label {
    color: var(--rec-faint);
  }

  /* The one button on the page, framed like the submit button it leads to */
  .masthead__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--rec-ink);
    color: var(--rec-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: background-color var(--motion-fast, 160ms) ease;
  }

  .masthead__cta:hover,
  .masthead__cta:focus-visible {
    background-color: oklch(var(--un-preset-theme-colors-primary) / 0.07);
  }

  .masthead__cta:active {
    background-color: oklch(var(--un-preset-theme-colors-primary) / 0.13);
  }

  /* ── Shared section rhythm ────────────────────────────── */
  .spinning,
  .records-section {
    min-width: 0;
    padding-block: var(--section-gap);
  }

  .records-section {
    border-top: 1px solid var(--rec-hair);
  }

  .records-section:last-child {
    padding-bottom: 0;
  }

  .records-empty {
    color: var(--rec-muted);
  }

  /* ── Now Spinning ─────────────────────────────────────── */
  /* Phones: cover beside the title, the rest full width underneath */
  .spinning__body {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    grid-template-areas:
      'cover title'
      'excerpt excerpt'
      'foot foot';
    align-items: center;
    column-gap: 1rem;
  }

  .spinning__body[hidden] {
    display: none;
  }

  .spinning__cover {
    grid-area: cover;
    display: block;
  }

  .spinning__title {
    grid-area: title;
    max-width: 30em;
    margin: 0;
    color: var(--rec-ink);
    font-family: var(--rec-serif);
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .spinning__excerpt {
    grid-area: excerpt;
    display: -webkit-box;
    max-width: 38em;
    margin: 0.85rem 0 0;
    overflow: hidden;
    color: var(--rec-ink-2);
    font-size: 0.875rem;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .spinning__foot {
    grid-area: foot;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
    max-width: 44rem;
    margin-top: 0.5rem;
  }

  .spinning__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6em;
    min-width: 0;
  }

  .spinning__album {
    color: var(--rec-ink);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .spinning__artist {
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .spinning__sep {
    color: var(--rec-faint);
  }

  /* ── New Arrivals: compact slips in one row ───────────── */
  .arrivals {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--rec-hair);
  }

  .arrivals li {
    min-width: 0;
  }

  .arrivals li + li {
    border-top: 1px solid var(--rec-hair);
  }

  .arrival {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0;
    color: var(--rec-ink-2);
  }

  .arrival__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .arrival__name {
    overflow: hidden;
    color: var(--rec-ink);
    font-family: var(--rec-serif);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--motion-base, 220ms) ease;
  }

  .arrival:hover .arrival__name,
  .arrival:focus-visible .arrival__name {
    text-decoration-color: currentColor;
  }

  .arrival__meta {
    overflow: hidden;
    color: var(--rec-faint);
    white-space: nowrap;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }

  /* ── The Collection: albums on a shelf, two to a row ─── */
  .collection {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2.2vw, 1.5rem);
  }

  .collection__more {
    margin-top: clamp(1rem, 2.2vw, 1.5rem);
  }

  .collection__more[open] .collection {
    margin-top: 0.5rem;
  }

  .collection__toggle {
    margin: 0;
    cursor: pointer;
    list-style: none;
  }

  .collection__toggle::-webkit-details-marker {
    display: none;
  }

  .collection__toggle-open,
  .collection__more[open] .collection__toggle-closed {
    display: none;
  }

  .collection__more[open] .collection__toggle-open {
    display: inline;
  }

  .crate {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rec-hair);
  }

  .crate__note {
    color: var(--rec-faint);
  }

  .crate__list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .crate__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    min-height: 2.75rem;
    padding: 0.6rem 0;
    color: var(--rec-ink-2);
  }

  .crate__name {
    color: var(--rec-ink);
  }

  .crate__desc {
    color: var(--rec-muted);
    font-size: 0.875rem;
  }

  /* ── Wider phones and up: cover | info, centred on each other ── */
  @media (min-width: 40rem) {
    .spinning__body {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      /* The empty rows share any spare height, so the text sits level with the cover's centre */
      grid-template-rows: 1fr auto auto auto 1fr;
      grid-template-areas:
        'cover .'
        'cover title'
        'cover excerpt'
        'cover foot'
        'cover .';
      column-gap: clamp(1.5rem, 2.4vw, 2rem);
      max-width: 52rem;
    }

    .spinning__cover {
      align-self: center;
    }

    .spinning__excerpt {
      margin-top: 0.6rem;
    }
  }

  /* ── Tablet ───────────────────────────────────────────── */
  @media (min-width: 48rem) {
    .masthead__meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .masthead__meta > div {
      flex-direction: row;
      align-items: baseline;
      gap: 0.5em;
    }

    .masthead__slash {
      display: inline;
    }

    .masthead__meta > div:nth-child(2) {
      justify-content: center;
      align-items: baseline;
    }

    .masthead__meta > div:nth-child(3) {
      justify-content: flex-end;
      align-items: baseline;
    }

    /* Intro on the left, the submit entry in its own column on the right */
    .masthead__body {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: stretch;
      column-gap: clamp(2rem, 5vw, 4rem);
    }

    .masthead__submit {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.6rem;
      padding: 0 0 0 clamp(1.25rem, 2.4vw, 1.75rem);
      border-top: none;
      border-left: 1px solid var(--rec-hair);
    }

    .collection {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .arrivals {
      grid-template-columns: repeat(var(--arrival-count, 3), minmax(0, 1fr));
    }

    .arrivals li + li {
      padding-left: clamp(1rem, 2vw, 1.5rem);
      border-top: none;
      border-left: 1px solid var(--rec-hair);
    }

    .arrivals li:not(:last-child) {
      padding-right: clamp(1rem, 2vw, 1.5rem);
    }
  }
</style>
