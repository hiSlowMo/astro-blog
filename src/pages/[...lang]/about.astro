---
import { getCollection, render } from 'astro:content'
import Signature from '@/components/Widgets/Signature.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
// Get about page content with different language
const allAboutEntries = await getCollection('about')
const aboutEntry = allAboutEntries.find(entry => entry.data.lang === currentLang)
  ?? allAboutEntries.find(entry => entry.data.lang === '')
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null }
---

<Layout enableContentEnhancements>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- About Page Content -->
  <div class="heti">
    {Content && <Content />}
    <Signature mode="once-on-view" />
  </div>
</Layout>

<style is:global>
  /* Slowly rotating line rings behind the avatar in about.md */
  .about-avatar {
    position: relative;
    display: grid;
    flex-shrink: 0;
  }

  .about-orbit {
    --orbit-line: oklch(var(--un-preset-theme-colors-secondary) / 0.24);
    --orbit-faint: oklch(var(--un-preset-theme-colors-secondary) / 0.14);
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: 220%;
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
  }

  .about-orbit > span,
  .about-orbit > span::before,
  .about-orbit > span::after {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
  }

  .about-orbit > span::before,
  .about-orbit > span::after {
    content: '';
  }

  /* Inner disc with a solid ring, a dashed outer ring and a small satellite */
  .about-orbit-ring {
    width: 66%;
    aspect-ratio: 1;
    border: 1px solid var(--orbit-line);
    border-radius: 50%;
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.05);
    animation: about-orbit-spin 180s linear infinite;
  }
  .about-orbit-ring::before {
    width: 128%;
    aspect-ratio: 1;
    border: 1px dashed var(--orbit-line);
    border-radius: 50%;
  }
  .about-orbit > .about-orbit-ring::after {
    top: -14%;
    width: 5px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: oklch(var(--un-preset-theme-colors-primary) / 0.55);
  }

  /* Crosshair lines turning the other way */
  .about-orbit-cross {
    width: 100%;
    aspect-ratio: 1;
    animation: about-orbit-spin 120s linear infinite reverse;
  }
  .about-orbit-cross::before,
  .about-orbit-cross::after {
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--orbit-line) 25%, var(--orbit-line) 75%, transparent);
  }
  .about-orbit-cross::after {
    rotate: 90deg;
  }

  /* Hatched outer band, faded on both sides */
  .about-orbit-hatch {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-linear-gradient(45deg, var(--orbit-faint) 0 1px, transparent 1px 6px);
    -webkit-mask-image: radial-gradient(closest-side, transparent 72%, #000 80%, #000 88%, transparent 100%);
    mask-image: radial-gradient(closest-side, transparent 72%, #000 80%, #000 88%, transparent 100%);
  }

  @keyframes about-orbit-spin {
    to {
      rotate: 360deg;
    }
  }

  html.reduce-motion .about-orbit > span {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-orbit > span {
      animation: none;
    }
  }
</style>
