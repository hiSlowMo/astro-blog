---
import { getCollection, render } from 'astro:content'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { hasMathContent } from '@/utils/math'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
// Get about page content with different language
const allAboutEntries = await getCollection('about')
const aboutEntry = allAboutEntries.find(entry => entry.data.lang === currentLang)
  ?? allAboutEntries.find(entry => entry.data.lang === '')
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null }
const hasMath = hasMathContent(aboutEntry?.body, aboutEntry?.filePath)
---

<Layout pageTitle={ui[currentLang].about} pageDescription="关于 SlowMo：一名软件工程专业的学生，记录计算机、排版美学与日常思考。" enableContentEnhancements enableKatex={hasMath}>
  <div class="about-content">
    {Content && <Content />}
  </div>
</Layout>

<style is:global>
  .about-content {
    --about-column: var(--editorial-index);
    --about-gap: var(--editorial-gap);
    color: oklch(var(--un-preset-theme-colors-primary) / .9);
    line-height: 1.75;
  }

  .about-intro, .about-row {
    display: grid;
    grid-template-columns: var(--about-column) minmax(0, 1fr);
    column-gap: var(--about-gap);
    align-items: start;
  }

  .about-intro {
    grid-template-areas: "title title" "avatar bio";
    row-gap: 1rem;
    margin-bottom: 2rem;
    font-size: var(--page-title-size);
  }

  .about-intro h1 {
    grid-area: title;
    line-height: 1.4;
    text-wrap: balance;
  }

  .about-opening {
    display: inline-block;
    padding-inline: .27em;
    background: var(--text-meta, oklch(var(--un-preset-theme-colors-primary)));
    color: oklch(var(--un-preset-theme-colors-background));
    mask-image: var(--cut-start), var(--cut-end);
    mask-composite: intersect;
  }

  .about-avatar {
    grid-area: avatar;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    margin-top: .19em;
    border-radius: 1rem;
  }

  .about-bio {
    grid-area: bio;
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .about-bio .signature-wrapper {
    width: min(8.5rem, 100%);
    margin: .85rem 0 0 auto;
  }

  .about-row {
    border-top: var(--section-divider);
    padding-block: 1.2rem;
    align-items: baseline;
  }

  .about-row li + li {
    margin-top: .25rem;
  }

  .about-topics ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--about-gap);
    color: oklch(var(--un-preset-theme-colors-secondary));
  }

  .about-topics li {
    padding-block: .35rem;
  }

  .about-topics li:nth-child(n + 3) {
    border-top: var(--section-divider);
  }

  .about-topics strong {
    color: var(--text-heading, oklch(var(--un-preset-theme-colors-primary)));
    font-weight: 600;
  }

  .about-topics li + li {
    margin-top: 0;
  }

  .about-row a {
    text-decoration: underline;
    text-underline-offset: .18em;
    text-decoration-color: oklch(var(--un-preset-theme-colors-secondary) / .6);
  }

  .about-row a:hover {
    text-decoration-color: currentColor;
  }

  .about-contacts li + li {
    margin-top: 0;
    border-top: var(--section-divider);
  }

  .about-contacts a {
    display: grid;
    grid-template-columns: var(--about-column) minmax(0, 1fr) auto;
    gap: var(--about-gap);
    align-items: center;
    min-height: 2.75rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    text-decoration: none;
  }

  .about-contacts a strong {
    color: var(--text-heading, oklch(var(--un-preset-theme-colors-primary)));
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .about-contacts a:is(:hover, :focus-visible) strong {
    text-decoration: underline;
    text-underline-offset: .18em;
  }

  .about-note {
    margin: 1.5rem 0 0 calc(var(--about-column) + var(--about-gap));
    color: oklch(var(--un-preset-theme-colors-secondary) / .86);
    font-size: .85rem;
  }

  @media (max-width: 768px) {
    .about-content { --about-column: clamp(4rem, 14vw, 5rem); }
    .about-intro {
      grid-template-columns: var(--about-column) minmax(0, 1fr);
      grid-template-areas:
        "title title"
        "avatar identity"
        "bio bio"
        "signature signature";
      gap: 1rem;
    }

    .about-avatar { margin-top: 0; }
    .about-bio { display: contents; }
    .about-identity {
      grid-area: identity;
      align-self: center;
      display: grid;
      gap: .2rem;
      line-height: 1.45;
    }
    .about-identity-lead { display: none; }
    .about-role {
      color: oklch(var(--un-preset-theme-colors-secondary));
      font-size: .9rem;
    }
    .about-description { grid-area: bio; }
    .about-bio .signature-wrapper {
      grid-area: signature;
      justify-self: end;
      margin: 0;
    }
    .about-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: .75rem;
      padding-block: 1rem;
    }
    .about-row ul {
      display: grid;
      row-gap: .35rem;
      line-height: 1.55;
    }
    .about-row li + li { margin-top: 0; }
    .about-topics ul {
      row-gap: 0;
      column-gap: 1rem;
    }
    .about-contacts ul {
      row-gap: 0;
    }
    .about-note { margin-inline-start: 0; }
  }
</style>
