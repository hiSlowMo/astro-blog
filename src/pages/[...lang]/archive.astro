---
import SortableDate from '@/components/SortableDate.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import { allLocales, themeConfig } from '@/config'
import { getUsedCategoryFilters } from '@/data/post-categories'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getPostPath, getTagPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getPostsByYear } from '@/utils/content'
import { countMarkdownWords } from '@/utils/markdown-content.mjs'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const postsByYear = await getPostsByYear(currentLang, { includePinned: true })
const currentUI = ui[currentLang]

const allPosts = Array.from(postsByYear.values()).flat()
const categoryFilters = getUsedCategoryFilters(allPosts)

const { birthYear } = themeConfig.site

function formatWordCount(count: number) {
  if (count >= 10000) {
    const value = Math.round((count / 10000) * 100) / 100
    return `${value}万字词`
  }
  return `${count}字词`
}

function getAgeForYear(year: number) {
  if (!birthYear) {
    return ''
  }

  const age = year - birthYear
  return age >= 0 ? `${age} 岁` : ''
}
---

<Layout pageTitle={currentUI.archive} pageDescription="按年份浏览 SlowMo 的全部公开文章，记录学习、技术实践与生活思考。">
  <div data-archive-root>
    <h2 class="section-label archive-heading">{currentUI.archive} <small lang="en">ARCHIVE</small></h2>
    <section class="archive-toolbar font-navbar">
      <div class="archive-toolbar-left">
        <div class="archive-filter-dropdown" data-filter-dropdown data-open="0">
          <button
            id="archive-filter-trigger"
            class="archive-filter-trigger"
            type="button"
            aria-label="分类筛选"
            aria-controls="archive-filter-menu"
            aria-expanded="false"
            aria-haspopup="listbox"
            data-dropdown-trigger
          >
            <span class="archive-filter-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 4h7l9 9-7 7-9-9zM14 4l9 9-7 7"/><circle cx="7" cy="8" r="1"/></svg>
            </span>
            <span class="archive-filter-label" data-dropdown-label>分类</span>
            <span class="archive-filter-caret" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="1em" height="1em"><path fill="none" stroke="currentColor" stroke-width="1.5" d="m5.5 8 4.5 4.5L14.5 8" /></svg>
            </span>
          </button>

          <div
            id="archive-filter-menu"
            class="archive-filter-menu"
            role="listbox"
            aria-label="分类列表"
            aria-hidden="true"
            data-dropdown-menu
          >
            <button
              class="archive-filter-option is-active"
              type="button"
              data-filter="all"
              data-trigger-label="分类"
              role="option"
              aria-selected="true"
            >
              <span class="archive-filter-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 4h7l9 9-7 7-9-9zM14 4l9 9-7 7"/><circle cx="7" cy="8" r="1"/></svg>
              </span>
              全部
            </button>

            {categoryFilters.map(category => (
              <button
                class="archive-filter-option"
                type="button"
                data-filter={category.value}
                data-filter-values={(category.matches ?? [category.value]).join(',')}
                role="option"
                aria-selected="false"
              >
                <span class="archive-filter-icon" aria-hidden="true" set:html={category.icon} />
                {category.label}
              </button>
            ))}
          </div>
        </div>

        <button class="archive-filter-plain" type="button" data-sort-button title="从新到旧排列，点击切换创建日期和更新日期">
          <span class="archive-sort-label">创建日期</span>
          <span aria-hidden="true">↓</span>
          <span class="sr-only">，从新到旧，点击切换排序字段</span>
        </button>
      </div>

    </section>

    <div class="archive-years">
      {[...postsByYear.entries()].map(([year, posts]) => {
        const yearAge = getAgeForYear(year)
        const yearWords = posts.reduce((sum, post) => sum + countMarkdownWords(post.body ?? '').total, 0)

        return (
          <section class="archive-year" data-year={year}>
            <header class="archive-year-heading">
              <h3 class="archive-year-watermark">{year}</h3>
              <div class="archive-year-watermark archive-year-detail">
                <span class="archive-year-age">{yearAge}</span>
                <span class="archive-year-stats">{formatWordCount(yearWords)} · {posts.length}篇</span>
              </div>
            </header>

            <ul class="archive-list">
              {posts.map((post) => {
                const slug = post.data.abbrlink || post.id
                const tags = post.data.tags ?? []
                const categories = post.data.categories ?? []

                return (
                  <li
                    class="archive-item"
                    data-categories={categories.join(',')}
                    data-created={post.data.published.valueOf()}
                    data-updated={(post.data.updated ?? post.data.published).valueOf()}
                  >
                    <SortableDate class="archive-date font-time" date={post.data.published} updatedDate={post.data.updated} format="MM/DD" />

                    <a class="archive-title module-title" href={getPostPath(slug, currentLang)}>
                      {post.data.title}
                    </a>
                    {(post.data.status || tags.length > 0) && (
                      <div class="archive-meta">
                        {post.data.status && <StatusBadge status={post.data.status} compact />}
                        {tags.length > 0 && (
                          <div class="archive-tags">
                            {tags.slice(0, 2).map((tag, index) => (
                              <span class="archive-tag-entry">
                                <a class="archive-tag" href={getTagPath(tag, currentLang)} title={tag}>#{tag}</a>
                                {index === 1 && tags.length > 2 && <span aria-label="更多标签见文章页">…</span>}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    )}
                  </li>
                )
              })}
            </ul>
          </section>
        )
      })}
    </div>
  </div>
</Layout>

<script>
  import '@/scripts/archive-filters'
</script>

<style>
  :root {
    /* 控件统一高度（更紧凑就改成 1.75rem / 1.85rem） */
    --archive-control-h: 1.85rem;
    --archive-menu-open-duration: var(--motion-fast);
    --archive-menu-close-duration: var(--motion-fast);
    --archive-layout-duration: var(--motion-slow);
    --archive-motion-easing: var(--motion-ease-standard);
    --archive-sort-col-w: 6.25rem;
  }

  [data-archive-root] {
    --archive-index-width: 5.75rem;
    --archive-column-gap: .75rem;
  }

  [data-archive-root][data-layout-animating='1'] .archive-year,
  [data-archive-root][data-layout-animating='1'] .archive-item {
    will-change: opacity, max-height, transform;
  }

  /* ===== 顶部工具栏 ===== */
  .archive-heading {
    margin: 0 0 1rem;
  }

  .archive-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 30;
  }

  .archive-toolbar-left {
    display: grid;
    align-items: center;
    grid-template-columns: var(--archive-index-width) var(--archive-sort-col-w);
    gap: var(--archive-column-gap);
    font-size: 0.9rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.75);
  }

  /* ===== 控件（summary/button）统一盒模型，避免不齐高 ===== */
  .archive-filter-dropdown {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    height: var(--archive-control-h);
    inline-size: 100%;
    isolation: isolate;
    z-index: 1;
  }

  .archive-filter-trigger,
  .archive-filter-plain {
    box-sizing: border-box;
    height: var(--archive-control-h);
    inline-size: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;

    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;

    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0;
    user-select: none;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .archive-filter-trigger {
    height: 100%;
  }

  .archive-filter-plain {
    inline-size: var(--archive-sort-col-w);
  }

  /* 悬停与展开只换文字色，不再长出一块底色 */
  .archive-filter-plain:hover,
  .archive-filter-dropdown[data-open='1'] .archive-filter-trigger,
  .archive-filter-trigger:hover {
    color: oklch(var(--un-preset-theme-colors-primary) / 0.9);
    background-color: transparent;
    border-color: transparent;
  }

  .archive-filter-plain:active,
  .archive-filter-trigger:active {
    color: oklch(var(--un-preset-theme-colors-primary) / 0.75);
  }

  .archive-filter-icon {
    width: 0.95rem;
    height: 0.95rem;
    display: inline-flex;
    align-items: center;
  }

  .archive-filter-icon svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .archive-filter-caret {
    margin-left: 0.15rem;
    opacity: 0.6;
    flex: none;
    transition: transform var(--archive-menu-close-duration) var(--archive-motion-easing);
  }

  .archive-filter-label,
  .archive-sort-label {
    min-width: 0;
    white-space: nowrap;
  }

  .archive-filter-dropdown[data-open='1'] .archive-filter-caret {
    transform: rotate(180deg);
    transition-duration: var(--archive-menu-open-duration);
  }

  /* ===== 下拉菜单 ===== */
  .archive-filter-menu {
    position: absolute;
    top: 100%;
    margin-top: 0.12rem;
    left: 0;

    inline-size: max(100%, 10.75rem);
    max-height: 320px;
    overflow: auto;

    background: oklch(var(--un-preset-theme-colors-background) / 0.98);
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.2);
    border-radius: 0.75rem;
    padding: 0.28rem;

    box-shadow: 0 18px 40px oklch(0 0 0 / 0.35);
    display: grid;
    gap: 0.1rem;
    z-index: 60;
    transform-origin: top left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
    transition:
      opacity var(--archive-menu-close-duration) var(--archive-motion-easing),
      transform var(--archive-menu-close-duration) var(--archive-motion-easing),
      visibility 0s linear var(--archive-menu-close-duration);
    will-change: opacity, transform;
  }

  .archive-filter-dropdown[data-open='1'] .archive-filter-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity var(--archive-menu-open-duration) var(--archive-motion-easing),
      transform var(--archive-menu-open-duration) var(--archive-motion-easing),
      visibility 0s linear 0s;
  }

  .archive-filter-option {
    display: flex;
    align-items: center;
    gap: 0.4rem;

    padding: 0.32rem 0.45rem;
    border-radius: 0.55rem;
    border: none;
    background: transparent;
    color: inherit;

    cursor: pointer;
    text-align: left;
    font-size: 0.88rem;
    line-height: 1.2;

    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform var(--archive-menu-close-duration) var(--archive-motion-easing);
  }

  .archive-filter-option:active {
    transform: translateY(1px);
  }

  .archive-filter-option:hover,
  .archive-filter-option.is-active {
    background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.12);
    color: oklch(var(--un-preset-theme-colors-primary) / 0.95);
  }

  .archive-filter-menu::-webkit-scrollbar {
    width: 8px;
  }

  .archive-filter-menu::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    background-clip: content-box;
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.2);
    border-radius: 999px;
  }

  /* ===== 年份列表容器 ===== */
  .archive-years {
    display: flex;
    flex-direction: column;
  }

  .archive-year {
    --archive-year-font-size: clamp(1rem, 6.5vw, 5.2rem);
    position: relative;
    padding-top: 0;
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.15);
    transition:
      opacity var(--archive-layout-duration) var(--archive-motion-easing),
      transform var(--archive-layout-duration) var(--archive-motion-easing),
      max-height var(--archive-layout-duration) var(--archive-motion-easing);
    overflow: hidden;
    margin-bottom: 3.6rem;
  }

  .archive-year:first-child {
    border-top: none;
  }

  .archive-year:last-child {
    margin-bottom: 0;
  }

  /* ===== 年份水印（年份/年龄） ===== */
  .archive-year-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .75rem;
    line-height: 1;
  }

  .archive-year-watermark {
    font-family: var(--font-sans);
    font-size: var(--archive-year-font-size);
    font-weight: 700;
    letter-spacing: 0.001em;
    font-variant-numeric: tabular-nums;
    line-height: 1;

    color: oklch(var(--un-preset-theme-colors-secondary) / 0.3);
    opacity: 1;

    pointer-events: none;
    user-select: none;
    z-index: 0;

    /* 核心遮罩：从顶部到 75% 的位置完全显示(black)，最后 25% 快速淡出 */
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 75%,         /* 在 75% 之前都是完全清晰的 */
      rgba(0, 0, 0, 0.2) 100% /* 到底部时变得极淡 */
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 75%,
      rgba(0, 0, 0, 0.2) 100%
    );
    transition: color 220ms ease, -webkit-text-stroke-color 220ms ease;
  }

  @supports (-webkit-text-stroke: 1px black) {
    .archive-year-watermark {
      color: transparent;
      -webkit-text-stroke: 2px oklch(var(--un-preset-theme-colors-secondary) / 0.36);
    }
  }

  .archive-year-detail {
    display: grid;
    text-align: right;
    align-items: center;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    white-space: nowrap;
  }

  .archive-year-age,
  .archive-year-stats {
    grid-area: 1 / 1;
    transition: opacity var(--archive-layout-duration) var(--archive-motion-easing),
      transform var(--archive-layout-duration) var(--archive-motion-easing);
  }

  .archive-year-stats {
    font-size: .35em;
    letter-spacing: .02em;
    -webkit-text-stroke-width: 0;
    opacity: 0;
    transform: translateY(.35rem);
  }

  .archive-year.is-active .archive-year-watermark {
    color: oklch(var(--un-preset-theme-colors-primary) / .8);
    -webkit-text-stroke-color: transparent;
  }

  .archive-year.is-active .archive-year-age {
    opacity: 0;
    transform: translateY(-.35rem);
  }

  .archive-year.is-active .archive-year-stats {
    opacity: .75;
    transform: translateY(65%);
  }

  /* ===== 文章列表 ===== */
  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 1;
  }

  .archive-item {
    display: grid;
    grid-template-columns: var(--archive-index-width) minmax(0, 1fr) minmax(0, 23%);
    align-items: baseline;
    gap: .12rem var(--archive-column-gap);

    /* 裸行：不加底色与描边，悬停只换文字色 */
    padding: .6rem 0;

    overflow: hidden;

    transition:
      transform var(--archive-layout-duration) var(--archive-motion-easing),
      opacity var(--archive-layout-duration) var(--archive-motion-easing),
      max-height var(--archive-layout-duration) var(--archive-motion-easing),
      padding var(--archive-layout-duration) var(--archive-motion-easing),
      margin var(--archive-layout-duration) var(--archive-motion-easing);
  }

  .archive-item.is-exiting {
    opacity: 0;
    transform: translateY(-0.24rem) scale(0.992);
    pointer-events: none;
  }

  .archive-item.is-hidden {
    opacity: 0;
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-color: transparent;
    transform: translateY(-0.4rem);
    pointer-events: none;
  }

  .archive-year.is-hidden {
    opacity: 0;
    max-height: 0;
    padding-top: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-top-color: transparent;
    transform: translateY(-0.6rem);
    pointer-events: none;
  }

  .archive-year.is-exiting {
    opacity: 0.22;
    transform: translateY(-0.32rem);
    pointer-events: none;
  }

  .archive-date {
    /* 日期统一走站点等宽字体（JetBrains Mono），与其他页面一致 */
    font-size: .875rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.9);
    letter-spacing: 0.09em;
  }

  .archive-title {
    grid-column: 2;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .archive-meta {
    display: contents;
  }

  .archive-meta :global(.status-badge) {
    grid-column: 2;
    grid-row: 2;
  }

  .archive-title:hover {
    color: oklch(var(--un-preset-theme-colors-primary) / 1);
  }

  .archive-tags {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    gap: .1rem .45rem;
    padding-top: .18rem;
    font-size: .8rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    white-space: nowrap;
  }

  .archive-tag {
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    color: inherit;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .archive-tag-entry {
    display: inline-flex;
    min-width: 0;
    max-width: 100%;
    gap: .2em;
  }

  .archive-tag:hover,
  .archive-tag:focus-visible {
    color: oklch(var(--un-preset-theme-colors-primary) / .8);
  }

  /* ===== 手机适配 ===== */
  @media (max-width: 768px) {
    [data-archive-root] {
      --archive-index-width: 3.2rem;
      --archive-column-gap: .6rem;
    }

    .archive-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-bottom: .65rem;
    }

    .archive-toolbar-left {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
      gap: 0.85rem;
      margin-inline-start: -0.4rem;
    }

    .archive-filter-dropdown {
      position: relative;
      flex: none;
      height: auto;
      min-width: 0;
      inline-size: auto;
      z-index: 3;
    }

    /* 与首页同一套：裸文字，只有颜色变化 */
    .archive-filter-trigger,
    .archive-filter-plain {
      height: auto;
      padding: 0.5rem 0.4rem;
      border: none;
      border-radius: 0;
      background: transparent;
      gap: 0.12rem;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1;
      color: oklch(var(--un-preset-theme-colors-secondary) / 0.74);
    }

    .archive-filter-trigger {
      justify-content: flex-start;
      min-width: 0;
    }

    .archive-filter-plain {
      inline-size: auto;
      flex: none;
      min-inline-size: auto;
      justify-content: center;
    }

    .archive-filter-icon,
    .archive-filter-icon svg {
      width: 0.74rem;
      height: 0.74rem;
    }

    .archive-filter-label,
    .archive-sort-label {
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: inherit;
      letter-spacing: 0;
    }

    .archive-filter-label {
      flex: 1;
    }

    .archive-filter-caret {
      margin-left: 0.04rem;
      opacity: 0.48;
    }

    .archive-filter-menu {
      top: calc(100% + 0.24rem);
      left: 0;
      right: auto;
      margin-top: 0;
      inline-size: min(12rem, calc(100vw - 2.4rem));
      min-width: 0;
      max-width: none;
      max-height: min(15.5rem, 48vh);
      border-radius: 0.82rem;
      padding: 0.22rem;
      z-index: 90;
      transform-origin: top left;
      box-shadow: 0 12px 28px oklch(0 0 0 / 0.24);
    }

    .archive-filter-option {
      min-height: 2.1rem;
      padding: 0.44rem 0.54rem;
      font-size: 0.84rem;
      line-height: 1.15;
      border-radius: 0.62rem;
      touch-action: manipulation;
    }

    .archive-filter-dropdown,
    .archive-filter-plain {
      align-self: center;
    }

    .archive-year {
      --archive-year-font-size: clamp(2.6rem, 14vw, 4rem);
      margin-bottom: 2rem;
    }

    .archive-year-heading {
      margin-bottom: .45rem;
    }

    .archive-year-detail {
      font-size: clamp(2.2rem, 13vw, 3.6rem);
    }

    .archive-item {
      grid-template-columns: var(--archive-index-width) minmax(0, 1fr);
      padding: .35rem 0;
    }

    .archive-meta {
      grid-column: 2;
      display: flex;
      align-items: center;
      gap: .6rem;
      min-width: 0;
    }

    .archive-tags {
      flex-wrap: nowrap;
      padding-top: 0;
    }
  }

  @media (max-width: 360px) {
    .archive-toolbar {
      gap: 0.42rem;
    }

    .archive-toolbar-left {
      gap: 0.6rem;
    }

    .archive-filter-trigger,
    .archive-filter-plain {
      padding-inline: 0.34rem;
      font-size: 0.86rem;
    }

  }

  /* 减少动态：无动画 */
  @media (prefers-reduced-motion: reduce) {
    .archive-filter-menu,
    .archive-filter-caret,
    .archive-item,
    .archive-year,
