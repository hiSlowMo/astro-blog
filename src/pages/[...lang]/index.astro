---
import PostList from '@/components/PostList.astro'
import ReleaseSleeve from '@/components/Records/ReleaseSleeve.astro'
import { allLocales, themeConfig } from '@/config'
import { getUsedCategoryFilters } from '@/data/post-categories'
import { getLangRouteParam } from '@/i18n/lang'
import { getPostPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { getPostCoverURL, getPosts } from '@/utils/content'
import { formatPostDate } from '@/utils/date'
import { getPostDescription } from '@/utils/description'
import { getPageInfo } from '@/utils/page'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const [latest, ...recentPosts] = await getPosts(currentLang)
const categoryFilters = getUsedCategoryFilters(recentPosts)
const thumbnails = import.meta.glob<string>('/src/assets/post-thumbnails/*.webp', { eager: true, query: '?url', import: 'default' })
const thumbnail = latest && (getPostCoverURL(latest.data.cover) || thumbnails[`/src/assets/post-thumbnails/${latest.id}.webp`])
---

<Layout>
  {latest && (
    <section class="latest" aria-labelledby="latest-label">
      <h2 class="section-label" id="latest-label">最新发布 <small lang="en">LATEST RELEASE</small></h2>
      <article class:list={['latest-entry', { 'latest-entry--short': Array.from(latest.data.title.trim()).length <= 12 }]}>
        <time class="latest-date font-time" datetime={latest.data.published.toISOString()}>{formatPostDate(latest.data.published, themeConfig.global.dateFormat)}</time>
        <h3 class="latest-title page-title"><a href={getPostPath(latest.data.abbrlink || latest.id, currentLang)}>{latest.data.title}</a></h3>
        {thumbnail
          ? <img class="latest-thumbnail" src={thumbnail} alt="" width="144" height="144" decoding="async" />
          : <div class="latest-thumbnail"><ReleaseSleeve title={latest.data.title} published={latest.data.published} /></div>}
        <p class="latest-summary">{getPostDescription(latest, 'list')}</p>
      </article>
    </section>
  )}
  {recentPosts.length > 0 && (
<section data-posts-root aria-labelledby="recent-label">
    <header class="recent-heading">
      <h2 class="section-label" id="recent-label">近期收录 <small lang="en">RECENT ENTRIES</small></h2>
    </header>
    <section class="post-filter font-navbar">
      <div class="post-filter-list">
        <div class="post-filter-dropdown" data-filter-dropdown data-open="0">
          <button
            id="post-filter-trigger"
            class="post-filter-trigger"
            type="button"
            aria-label="全部分类"
            aria-controls="post-filter-menu"
            aria-expanded="false"
            aria-haspopup="listbox"
            data-dropdown-trigger
          >
            <span class="post-filter-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="1em" height="1em"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M4.5 5.5h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7.5l-3.5 3v-3h-0.5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z" /></svg>
            </span>
            <span class="post-filter-label" data-dropdown-label>全部分类</span>
            <span class="post-filter-caret" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="1em" height="1em"><path fill="none" stroke="currentColor" stroke-width="1.5" d="m5.5 8 4.5 4.5L14.5 8" /></svg>
            </span>
          </button>
          <div
            id="post-filter-menu"
            class="post-filter-menu"
            role="listbox"
            aria-label="分类列表"
            aria-hidden="true"
            data-dropdown-menu
          >
            <button
              class="post-filter-option is-active"
              type="button"
              data-filter="all"
              data-trigger-label="全部分类"
              role="option"
              aria-selected="true"
            >
              <span class="post-filter-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="1em" height="1em"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M4.5 5.5h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7.5l-3.5 3v-3h-0.5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z" /></svg>
              </span>
              显示全部
            </button>
            {categoryFilters.map(category => (
              <button
                class="post-filter-option"
                type="button"
                data-filter={category.value}
                data-filter-values={(category.matches ?? [category.value]).join(',')}
                role="option"
                aria-selected="false"
              >
                <span class="post-filter-icon" aria-hidden="true" set:html={category.icon} />
                {category.label}
              </button>
            ))}
          </div>
        </div>

        <button class="post-filter-plain" type="button" data-sort-button aria-label="切换排序字段">
          <span class="post-filter-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="1em" height="1em"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M5 4.5v2M15 4.5v2M4 8.5h12M5.5 11h3M11.5 11h3M5.5 14h3" /></svg>
          </span>
          <span class="post-sort-label">创建日期</span>
        </button>
      </div>
    </section>

    <div class="post-year-section">
      <PostList posts={recentPosts} lang={currentLang} />
    </div>
  </section>
)}
</Layout>

<script>
  import '@/scripts/post-filters'
</script>

<style>
  :root {
    --post-control-h: 1.85rem; /* 想更紧凑可改 1.75rem */
    --post-menu-open-duration: var(--motion-fast);
    --post-menu-close-duration: var(--motion-fast);
    --post-layout-duration: var(--motion-slow);
    --post-motion-easing: var(--motion-ease-standard);
    --post-filter-col-w: 7.5rem;
    --post-sort-col-w: 6.25rem;
  }

  [data-posts-root][data-layout-animating='1'] .post-year-section,
  [data-posts-root][data-layout-animating='1'] :global(.post-item) {
    will-change: opacity, max-height, transform;
  }

  /* ===== 顶部筛选条 ===== */
  .post-filter {
    display: flex;
    align-items: center;
    margin-bottom: 2rem;
    position: relative;
    z-index: 30;
  }

  .post-filter-list {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    font-size: 0.9rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.75);
  }

  .latest {
    container-type: inline-size;
  }

  #latest-label {
    display: inline-flex;
    padding: .32rem 1.45rem .32rem .6rem;
    mask-image: var(--cut-end);
    background: oklch(var(--un-preset-theme-colors-primary));
    color: oklch(var(--un-preset-theme-colors-background));
    font-size: 1rem;
    letter-spacing: .025em;
  }

  #latest-label small {
    color: inherit;
    font-size: .7rem;
  }

  .latest-date {
    grid-area: date;
    writing-mode: vertical-rl;
    justify-self: start;
    margin-top: .28rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    font: 500 clamp(.65rem, 2cqi, .76rem)/1 var(--font-mono);
    letter-spacing: .05em;
  }

  .latest-entry {
    display: grid;
    grid-template-columns: clamp(.75rem, 3cqi, 1.4rem) minmax(0, 1fr) clamp(4.5rem, 25cqi, 10rem);
    grid-template-areas: "date title title" "date summary cover";
    align-items: start;
    gap: clamp(.7rem, 2cqi, 1rem) clamp(.55rem, 2.5cqi, 1.1rem);
    margin: 1rem 0 clamp(1.2rem, 4cqi, 1.75rem);
  }

  .latest-entry--short {
    grid-template-columns: clamp(.75rem, 3cqi, 1.4rem) minmax(0, 1fr) clamp(4.5rem, 16cqi, 7rem);
    grid-template-areas: "date title cover" "date summary cover";
  }

  .latest-thumbnail {
    grid-area: cover;
    display: block;
    align-self: end;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    height: auto;
  }

  .latest-title {
    grid-area: title;
    margin: 0;
    font-size: clamp(1.75rem, 8.15cqi, 3.85rem);
    font-weight: 780;
    line-height: 1.1;
    letter-spacing: -.035em;
    text-wrap: balance;
    word-break: auto-phrase;
  }

  .latest-summary {
    grid-area: summary;
    align-self: end;
    margin: 0;
    max-width: 30em;
    font-size: clamp(.9rem, 2.6cqi, 1rem);
    line-height: 1.68;
    text-wrap: pretty;
  }

  .recent-heading {
    padding-top: .75rem;
    margin-bottom: .7rem;
    border-top: var(--rule-masthead) solid oklch(var(--un-preset-theme-colors-primary));
  }

  #recent-label {
    justify-content: space-between;
  }

  .post-year-section :global(.post-item:not(.is-hidden)) {
    padding-block: clamp(.6rem, 1.5vw, .85rem);
    margin-bottom: 0;
    border-top: var(--section-divider);
  }

  .latest-title a {
    text-decoration: underline solid transparent 2px;
    text-underline-offset: .12em;
    transition: text-decoration-color var(--motion-base) var(--motion-ease-standard);
  }

  @media (hover: hover) {
    .latest-title a:hover {
      text-decoration-color: oklch(var(--un-preset-theme-colors-primary) / .48);
    }
  }

  .latest-title a:focus-visible {
    text-decoration-color: currentColor;
  }

  /* ===== details/summary 控件：与归档页一致 ===== */
  .post-filter-dropdown {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    height: var(--post-control-h);
    inline-size: var(--post-filter-col-w);
    isolation: isolate;
  }

  .post-filter-trigger,
  .post-filter-plain {
    box-sizing: border-box;
    height: 100%;
    inline-size: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;

    padding: 0 0.5rem;

    /* 裸文字控件：透明边框只占位，避免 hover 时高度变化导致“跳” */
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;

    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0;
    user-select: none;
    list-style: none;

    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .post-filter-plain {
    height: var(--post-control-h);
    inline-size: var(--post-sort-col-w);
    justify-content: flex-end;
  }

  /* 悬停与展开只换文字色，不再长出一块底色 */
  .post-filter-plain:hover,
  .post-filter-dropdown[data-open='1'] .post-filter-trigger,
  .post-filter-trigger:hover {
    color: oklch(var(--un-preset-theme-colors-primary) / 0.9);
    background-color: transparent;
    border-color: transparent;
  }

  .post-filter-plain:active,
  .post-filter-trigger:active {
    color: oklch(var(--un-preset-theme-colors-primary) / 0.75);
  }

  .post-filter-icon {
    width: 0.95rem;
    height: 0.95rem;
    display: inline-flex;
    align-items: center;
  }

  .post-filter-icon svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .post-filter-caret {
    margin-left: 0.15rem;
    opacity: 0.6;
    flex: none;
    transition: transform var(--post-menu-close-duration) var(--post-motion-easing);
  }

  .post-filter-label,
  .post-sort-label {
    min-width: 0;
    white-space: nowrap;
  }

  .post-filter-dropdown[data-open='1'] .post-filter-caret {
    transform: rotate(180deg);
    transition-duration: var(--post-menu-open-duration);
  }

  /* ===== 下拉菜单：贴近按钮 + 可滚动 ===== */
  .post-filter-menu {
    position: absolute;
    top: 100%;
    margin-top: 0.12rem; /* 这里就是“按钮与菜单”的距离 */
    left: 0;

    inline-size: max(100%, 10.75rem);
    max-height: 320px;
    overflow: auto;

    background: oklch(var(--un-preset-theme-colors-background) / 0.98);
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.2);
    border-radius: 0.75rem;
    padding: 0.28rem;

    box-shadow: 0 18px 40px oklch(0 0 0 / 0.35);
    display: grid;
    gap: 0.1rem;
    z-index: 60;
    transform-origin: top left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
    transition:
      opacity var(--post-menu-close-duration) var(--post-motion-easing),
      transform var(--post-menu-close-duration) var(--post-motion-easing),
      visibility 0s linear var(--post-menu-close-duration);
    will-change: opacity, transform;
  }

  .post-filter-dropdown[data-open='1'] .post-filter-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity var(--post-menu-open-duration) var(--post-motion-easing),
      transform var(--post-menu-open-duration) var(--post-motion-easing),
      visibility 0s linear 0s;
  }

  .post-filter-option {
    display: flex;
    align-items: center;
    gap: 0.4rem;

    padding: 0.32rem 0.45rem;
    border-radius: 0.55rem;
    border: none;
    background: transparent;
    color: inherit;

    cursor: pointer;
    text-align: left;
    font-size: 0.88rem;
    line-height: 1.2;

    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform var(--post-menu-close-duration) var(--post-motion-easing);
  }

  .post-filter-option:active {
    transform: translateY(1px);
  }

  .post-filter-option:hover,
  .post-filter-option.is-active {
    background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.12);
    color: oklch(var(--un-preset-theme-colors-primary) / 0.95);
  }

  /* 滚动条更细一点（可选） */
  .post-filter-menu::-webkit-scrollbar {
    width: 8px;
  }
  .post-filter-menu::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    background-clip: content-box;
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.2);
    border-radius: 999px;
  }

  /* 键盘可访问性 */
  .post-filter-trigger:focus-visible,
  .post-filter-plain:focus-visible,
  .post-filter-option:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  /* ===== 文章分组隐藏动画（保留你原逻辑） ===== */
  .post-year-section {
    overflow: hidden;
    transition:
      opacity var(--post-layout-duration) var(--post-motion-easing),
      transform var(--post-layout-duration) var(--post-motion-easing),
      max-height var(--post-layout-duration) var(--post-motion-easing);
  }

  .post-year-section.is-hidden {
    opacity: 0;
    max-height: 0;
    margin-top: 0;
    margin-bottom: 0 !important;
    pointer-events: none;
    transform: translateY(-0.6rem);
  }

  :global(.post-item) {
    max-height: 16rem;
    overflow: hidden;
    transition:
      opacity var(--post-layout-duration) var(--post-motion-easing),
      max-height var(--post-layout-duration) var(--post-motion-easing),
      transform var(--post-layout-duration) var(--post-motion-easing),
      margin var(--post-layout-duration) var(--post-motion-easing);
  }

  :global(.post-item.is-hidden) {
    opacity: 0;
    max-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    transform: translateY(-0.4rem);
    pointer-events: none;
  }

  :global(.post-item.is-exiting) {
    opacity: 0;
    transform: translateY(-0.24rem) scale(0.992);
    pointer-events: none;
  }

  .post-year-section.is-exiting {
    opacity: 0.22;
    transform: translateY(-0.32rem);
    pointer-events: none;
  }

  /* ===== 手机适配 ===== */
  @media (max-width: 768px) {
    [data-posts-root] {
      position: relative;
    }

    .post-filter {
      position: relative;
      inline-size: auto;
      margin: 0 0 1.25rem;
      z-index: 35;
    }

    .post-filter-list {
      margin-inline: -0.45rem;
    }

    .post-filter-dropdown {
      position: relative;
      flex: none;
      min-width: 0;
      inline-size: auto;
    }

    .post-filter-trigger,
    .post-filter-plain {
      height: auto;
      padding: 0.5rem 0.45rem;
      border: none;
      border-radius: 0;
      background: transparent;
      gap: 0.12rem;
      font-size: 0.94rem;
      font-weight: 600;
      line-height: 1;
      color: oklch(var(--un-preset-theme-colors-secondary) / 0.74);
    }

    .post-filter-trigger {
      justify-content: flex-start;
      min-width: 0;
    }

    .post-filter-plain {
      inline-size: auto;
      flex: none;
      min-inline-size: auto;
      justify-content: center;
    }

    .post-filter-icon,
    .post-filter-icon svg {
      width: 0.74rem;
      height: 0.74rem;
    }

    .post-filter-label,
    .post-sort-label {
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: inherit;
      letter-spacing: 0;
    }

    .post-filter-trigger .post-filter-icon,
    .post-filter-plain .post-filter-icon {
      margin-right: 0.02rem;
    }

    .post-filter-label {
      flex: 1;
    }

    .post-filter-caret {
      margin-left: 0.04rem;
      opacity: 0.48;
    }

    .post-filter-menu {
      left: 0;
      right: auto;
      margin-top: 0.22rem;
      inline-size: min(12.4rem, calc(100vw - 9.25rem));
      min-width: 0;
      max-width: none;
      max-height: min(14.2rem, 44vh);
      border-radius: 0.78rem;
      padding: 0.18rem;
      z-index: 90;
      transform-origin: top left;
      box-shadow: 0 10px 24px oklch(0 0 0 / 0.22);
    }

    .post-filter-option {
      min-height: 1.95rem;
      padding: 0.4rem 0.5rem;
      font-size: 0.8rem;
      line-height: 1.15;
      border-radius: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-filter-menu,
    .post-filter-caret,
    .post-year-section,
    :global(.post-item) {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-title a { transition: none; }
  }

  :global(html.reduce-motion) .latest-title a,
  :global(html.reduce-motion) .post-filter-menu,
  :global(html.reduce-motion) .post-filter-caret,
  :global(html.reduce-motion) .post-year-section,
  :global(html.reduce-motion) .post-item {
    transition: none;
  }
</style>
