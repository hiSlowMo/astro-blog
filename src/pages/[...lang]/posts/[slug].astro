---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { getCollection, render } from 'astro:content'
import Comment from '@/components/Comment/Index.astro'
import PostDate from '@/components/PostDate.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import TagList from '@/components/TagList.astro'
import BackButton from '@/components/Widgets/BackButton.astro'
import Mermaid from '@/components/Widgets/Mermaid.astro'
import TOC from '@/components/Widgets/TOC.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getPostPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication, getPostCoverURL, getPostsBySeries, getPostUpdatedAt, shouldIncludePost } from '@/utils/content'
import { getPostDescription } from '@/utils/description'

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')
  const visiblePosts = posts.filter(post => shouldIncludePost(post.data, import.meta.env.DEV))

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(visiblePosts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  // Build a map of post slugs to their supported languages
  // Handles both specific language posts (e.g., 'en') and universal posts (lang: '')
  const slugToLangsMap = new Map<string, Set<Language>>()

  for (const post of visiblePosts) {
    const slug = post.data.abbrlink || post.id
    const lang = post.data.lang

    let langSet = slugToLangsMap.get(slug)
    if (!langSet) {
      langSet = new Set()
      slugToLangsMap.set(slug, langSet)
    }

    if (lang) {
      langSet.add(lang as Language)
    }
    else {
      allLocales.forEach(locale => langSet.add(locale))
    }
  }

  // Convert the map to a sorted record for the component props
  // Ensure languages are always sorted by the order defined in config
  const slugToLangs: Record<string, Language[]> = {}
  for (const [slug, langs] of slugToLangsMap) {
    slugToLangs[slug] = [...langs].sort((a, b) => allLocales.indexOf(a) - allLocales.indexOf(b))
  }
  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

  return allLocales.flatMap(lang => visiblePosts
    // Match current language or universal posts
    .filter(post => post.data.lang === lang || post.data.lang === '')
    .map((post) => {
      const slug = post.data.abbrlink || post.id
      return {
        params: { lang: getLangRouteParam(lang), slug },
        props: { post, supportedLangs: slugToLangs[slug] },
      }
    }),
  )
}

interface Props {
  post: CollectionEntry<'posts'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const hasMermaid = /^```mermaid(?:\s|$)/m.test(post.body ?? '')
const tocHeadings = post.data.toc ? headings : []
const updatedDate = getPostUpdatedAt(post)
const coverURL = getPostCoverURL(post.data.cover)
const seriesPosts = post.data.series
  ? await getPostsBySeries(post.data.series, currentLang)
  : []
const seriesItems = seriesPosts.map((seriesPost) => {
  const seriesSlug = seriesPost.data.abbrlink || seriesPost.id

  return {
    title: seriesPost.data.title,
    href: getPostPath(seriesSlug, currentLang),
    date: seriesPost.data.published.toISOString().split('T')[0],
    isCurrent: seriesSlug === slug,
  }
})
const searchTags = post.data.tags.join(' ')
const searchCategories = post.data.categories.join(' ')
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.id}
  supportedLangs={supportedLangs}
  enableContentEnhancements
>
  <article class="heti">
    <div id="post-top-anchor" aria-hidden="true" />

    <div class="post-search-signals" aria-hidden="true">
      {searchTags && (
        <p
          data-pagefind-meta={`tags:${searchTags}`}
          data-pagefind-weight="6"
        >
          {searchTags}
        </p>
      )}
      {searchCategories && (
        <p
          data-pagefind-meta={`categories:${searchCategories}`}
          data-pagefind-weight="4"
        >
          {searchCategories}
        </p>
      )}
    </div>

    <div class="relative">
      <!-- Go Back Button On Desktop -->
      <BackButton />
      <!-- Title -->
      <h1 class="post-title" data-pagefind-meta="title" data-pagefind-weight="8">
        <span
          transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          {post.data.title}
        </span>
      </h1>
    </div>

    <!-- Date -->
    <div
      id="post-date"
      class="mb-10 flex flex-wrap items-center gap-y-2 c-primary font-time"
      transition:name={`time-${slug}${currentLang ? `-${currentLang}` : ''}`}
      data-disable-theme-toggle-transition
    >
      <PostDate
        date={post.data.published}
        updatedDate={updatedDate}
        minutes={remarkPluginFrontmatter.minutes}
      />
      {post.data.status && (
        <StatusBadge
          status={post.data.status}
          className="ml-2.5"
        />
      )}
    </div>
    {coverURL && (
      <figure class="post-cover mb-10.5" data-pagefind-ignore>
        <img
          src={coverURL}
          alt={post.data.title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}
    <!-- TOC -->
    {(tocHeadings.length > 0 || seriesItems.length > 1) && (
      <div data-pagefind-ignore>
        <TOC headings={tocHeadings} seriesItems={seriesItems} />
      </div>
    )}
    <!-- Content -->
    <div id="post-content">
      <Content />
      <!-- Copyright -->
      <div id="post-copyright" />
      <!-- Tag List -->
      {post.data.tags?.length > 0 && (
        <div data-pagefind-ignore>
          <div class="mt-12.6 uno-decorative-line" />
          <TagList
            tags={post.data.tags}
            lang={currentLang}
          />
        </div>
      )}
      <!-- Comment -->
      <div id="post-comments" data-pagefind-ignore>
        <Comment />
      </div>
      {hasMermaid && <Mermaid />}
    </div>
  </article>
</Layout>

<style>
  .post-search-signals {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .post-cover {
    margin-left: 0;
    margin-right: 0;
  }

  .post-cover img {
    display: block;
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.14);
  }

</style>
