---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import Comment from '@/components/Comment/Index.astro'
import PostDate from '@/components/PostDate.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import TagList from '@/components/TagList.astro'
import BackButton from '@/components/Widgets/BackButton.astro'
import Mermaid from '@/components/Widgets/Mermaid.astro'
import TOC from '@/components/Widgets/TOC.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath, getPostPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication, getPostCoverURL, getPostsBySeries, getPostUpdatedAt, shouldIncludePost } from '@/utils/content'
import { getPostDescription } from '@/utils/description'
import { hasMathContent } from '@/utils/math'

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')
  const visiblePosts = posts.filter(post => shouldIncludePost(post.data, import.meta.env.DEV))

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(visiblePosts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  // Build a map of post slugs to their supported languages
  // Handles both specific language posts (e.g., 'en') and universal posts (lang: '')
  const slugToLangsMap = new Map<string, Set<Language>>()

  for (const post of visiblePosts) {
    const slug = post.data.abbrlink || post.id
    const lang = post.data.lang

    let langSet = slugToLangsMap.get(slug)
    if (!langSet) {
      langSet = new Set()
      slugToLangsMap.set(slug, langSet)
    }

    if (lang) {
      langSet.add(lang as Language)
    }
    else {
      allLocales.forEach(locale => langSet.add(locale))
    }
  }

  // Convert the map to a sorted record for the component props
  // Ensure languages are always sorted by the order defined in config
  const slugToLangs: Record<string, Language[]> = {}
  for (const [slug, langs] of slugToLangsMap) {
    slugToLangs[slug] = [...langs].sort((a, b) => allLocales.indexOf(a) - allLocales.indexOf(b))
  }
  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

  return allLocales.flatMap(lang => visiblePosts
    // Match current language or universal posts
    .filter(post => post.data.lang === lang || post.data.lang === '')
    .map((post) => {
      const slug = post.data.abbrlink || post.id
      return {
        params: { lang: getLangRouteParam(lang), slug },
        props: { post, supportedLangs: slugToLangs[slug] },
      }
    }),
  )
}

interface Props {
  post: CollectionEntry<'posts'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const hasMermaid = /^```mermaid(?:\s|$)/m.test(post.body ?? '')
const hasMath = hasMathContent(post.body, post.filePath)
const tocHeadings = post.data.toc ? headings : []
const updatedDate = getPostUpdatedAt(post)
const coverURL = getPostCoverURL(post.data.cover)
const seriesPosts = post.data.series
  ? await getPostsBySeries(post.data.series, currentLang)
  : []
const seriesItems = seriesPosts.map((seriesPost) => {
  const seriesSlug = seriesPost.data.abbrlink || seriesPost.id

  return {
    title: seriesPost.data.title,
    href: getPostPath(seriesSlug, currentLang),
    date: seriesPost.data.published.toISOString().split('T')[0],
    isCurrent: seriesSlug === slug,
  }
})
const searchTags = post.data.tags.join(' ')
const searchCategories = post.data.categories.join(' ')
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.id}
  article={post.data}
  supportedLangs={supportedLangs}
  enableContentEnhancements
  enableKatex={hasMath}
>
  <article class="heti">
    <div id="post-top-anchor" aria-hidden="true" />

    <div class="post-search-signals" aria-hidden="true">
      {searchTags && (
        <p
          data-pagefind-meta={`tags:${searchTags}`}
          data-pagefind-weight="6"
        >
          {searchTags}
        </p>
      )}
      {searchCategories && (
        <p
          data-pagefind-meta={`categories:${searchCategories}`}
          data-pagefind-weight="4"
        >
          {searchCategories}
        </p>
      )}
    </div>

    <BackButton />
    <header class="post-masthead">
      <h1 class="post-title" data-pagefind-meta="title" data-pagefind-weight="8">
        <span
          transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          {post.data.title}
        </span>
      </h1>
      <div
        id="post-date"
        class="font-time"
        transition:name={`time-${slug}${currentLang ? `-${currentLang}` : ''}`}
        data-disable-theme-toggle-transition
      >
        <PostDate
          date={post.data.published}
          updatedDate={updatedDate}
          minutes={remarkPluginFrontmatter.minutes}
        />
        {post.data.status && <StatusBadge status={post.data.status} />}
      </div>
    </header>
    {coverURL && (
      <figure class="post-cover mb-10.5" data-pagefind-ignore>
        <Image
          src={coverURL}
          alt={post.data.title}
          inferSize
          layout="constrained"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 768px) 100vw, 720px"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}
    <!-- TOC -->
    {(tocHeadings.length > 0 || seriesItems.length > 1) && (
      <div data-pagefind-ignore>
        <TOC headings={tocHeadings} seriesItems={seriesItems} />
      </div>
    )}
    <!-- Content -->
    <div id="post-content">
      <Content />
      <!-- Copyright -->
      <div id="post-copyright" />
      <!-- Tag List -->
      {post.data.tags?.length > 0 && (
        <div class="post-topics no-heti" data-pagefind-ignore>
          <a class="post-topics-index" href={getLocalizedPath('/tags/', currentLang)}>
            全部标签 <span aria-hidden="true">↗</span>
          </a>
          <TagList
            tags={post.data.tags}
            lang={currentLang}
          />
        </div>
      )}
      <!-- Comment -->
      <div id="post-comments" data-pagefind-ignore>
        <Comment />
      </div>
      {hasMermaid && <Mermaid />}
    </div>
  </article>
</Layout>

<style is:inline>
  .post-topics {
    display: grid;
    grid-template-columns: var(--editorial-index) minmax(0, 1fr);
    align-items: baseline;
    gap: .35rem var(--editorial-gap);
    margin-top: clamp(2rem, 6vw, 3.15rem);
    padding-block: .45rem;
    border-top: var(--section-divider);
  }

  .post-topics + #post-comments {
    --comments-margin-top: 0;
  }

  .post-topics-index {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    min-height: 2.75rem;
    font: 600 .9rem/1.4 var(--font-sans);
    color: oklch(var(--un-preset-theme-colors-primary));
    text-decoration: none;
  }

  .post-topics-index:is(:hover, :focus-visible) {
    color: oklch(var(--un-preset-theme-colors-accent));
  }

  .post-topics .tag-list {
    gap: 0 1.25rem;
  }

  .post-topics .tag-list-link {
    min-width: 0;
    max-width: 100%;
    align-items: center;
    min-height: 2.75rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (max-width: 639px) {
    .post-topics {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
  }

</style>

<style>
  .post-masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) fit-content(35%);
    align-items: start;
    gap: var(--editorial-gap);
    padding-bottom: 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: var(--section-divider);
  }

  .post-masthead .post-title {
    margin: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  #post-date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .35rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    font-size: .85rem;
  }

  #post-date > :global(*) {
    margin-inline: 0;
  }

  #post-date > :global(time:first-child) {
    padding: .2rem .55rem .2rem .95rem;
    mask-image: var(--cut-start);
    background: oklch(var(--un-preset-theme-colors-primary));
    color: oklch(var(--un-preset-theme-colors-background));
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .post-masthead {
      grid-template-columns: minmax(0, 1fr);
      gap: .9rem;
    }

    .post-masthead .post-title {
      font-size: clamp(1.5rem, 6.8vw, 2rem);
      line-height: 1.35;
      letter-spacing: normal;
      text-wrap: wrap;
    }

    #post-date {
      flex-flow: row wrap;
      align-items: center;
      gap: .35rem .65rem;
    }
  }

  .post-search-signals {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .post-cover {
    margin-left: 0;
    margin-right: 0;
  }

  .post-cover img {
    display: block;
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.14);
  }

</style>
