---
import type { Language } from '@/i18n/config'
import LanguageSwitcherIcon from '@/assets/icons/language-switcher.svg'
import ThemeToggleIcon from '@/assets/icons/theme-toggle.svg'
import { moreLocales, themeConfig } from '@/config'
import { getNextGlobalLangPath, getNextSupportedLangPath } from '@/i18n/path'
import { isPostPage } from '@/utils/page'

interface Props {
  supportedLangs: Language[]
}

const {
  light: { background: lightMode },
  dark: { background: darkMode },
} = themeConfig.color

const { supportedLangs } = Astro.props
const currentPath = Astro.url.pathname
const isPost = isPostPage(currentPath)

// Check if there are other languages to switch
const showLanguageSwitcher = moreLocales.length > 0
// Choose a language switch list according to supported languages
const nextUrl = supportedLangs.length > 0
  ? getNextSupportedLangPath(currentPath, supportedLangs) // Use supported languages when available
  : getNextGlobalLangPath(currentPath) // Fallback to all languages when no supported languages data

const { enabled: commentsEnabled, giscus, twikoo, waline } = themeConfig.comment
const hasCommentProvider = Boolean(
  giscus?.repo?.trim()
  || twikoo?.envId?.trim()
  || waline?.serverURL?.trim(),
)
const showCommentShortcut = isPost && commentsEnabled && hasCommentProvider
const showPostShortcuts = isPost
const utilityButtonCount = Number(showLanguageSwitcher) + 1 + Number(showPostShortcuts) + Number(showCommentShortcut)
const isSingleUtility = utilityButtonCount === 1
---

<div
  id="site-utility"
  class:list={[
  'fixed bottom-24 right-[min(7.25vw,3.731rem)] z-30 flex items-center gap-4 min-[823px]:max-lg:right-[calc(50vw-22rem)]',

  'lg:(right-[max(5rem,calc(50vw-35rem))] bottom-[max(13rem,12vh)] w-14rem justify-start)',
  isSingleUtility && 'site-utility--single',
]}
>
  <!-- Language Switcher -->
  {showLanguageSwitcher && (
    <a
      id="language-switcher"
      href={nextUrl}
      class="floating-utility-button c-secondary"
      aria-label="Switch website language"
    >
      <LanguageSwitcherIcon
        aria-hidden="true"
        class="floating-utility-button__icon"
        fill="currentColor"
      />
    </a>
  )}

  <!-- Theme Toggle -->
  <button
    id="theme-toggle-button"
    class="floating-utility-button c-secondary"
    data-light-mode={lightMode}
    data-dark-mode={darkMode}
    aria-label="Switch light/dark theme"
  >
      <ThemeToggleIcon
        aria-hidden="true"
        class="floating-utility-button__icon"
        fill="currentColor"
      />
    </button>

  {showPostShortcuts && (
    <button
      id="post-top-button"
      class="floating-utility-button floating-utility-button--ring c-primary/85"
      type="button"
      aria-label="Back to top"
    >
      <svg
        class="floating-utility-button__ring-svg"
        viewBox="0 0 36 36"
        aria-hidden="true"
        fill="none"
      >
        <circle
          cx="18"
          cy="18"
          r="15.5"
          stroke="currentColor"
          stroke-opacity="0.28"
          stroke-width="2"
        />
        <circle
          data-top-progress
          cx="18"
          cy="18"
          r="15.5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          transform="rotate(-90 18 18)"
          stroke-dasharray="97.389"
          stroke-dashoffset="97.389"
        />
        <path
          d="M12.75 12h10.5"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
        />
        <path
          d="M18 24v-9.5M13.75 18.5L18 14.25l4.25 4.25"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  )}

  {showCommentShortcut && (
    <button
      id="post-comment-button"
      class="floating-utility-button floating-utility-button--ring c-primary/85"
      type="button"
      aria-label="Jump to comments"
    >
      <svg
        class="floating-utility-button__ring-svg"
        viewBox="0 0 36 36"
        aria-hidden="true"
        fill="none"
      >
        <circle
          cx="18"
          cy="18"
          r="15.5"
          stroke="currentColor"
          stroke-width="2"
        />
        <path
          d="M12.25 11.75h11.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H16.8l-3.05 2.25v-2.25h-1.5a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  )}
</div>

<!-- Theme Toggle Script >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -->
<script>
import { prefersReducedMotion } from '@/scripts/motion'
// Theme toggling is shared with standalone layouts (see RecordLayout.astro)
import '@/scripts/theme-toggle'

function scrollToTarget(selector: string) {
  const target = document.querySelector<HTMLElement>(selector)
  if (!target) {
    return
  }

  const behavior = prefersReducedMotion()
    ? 'instant'
    : 'smooth'

  target.scrollIntoView({ behavior, block: 'start' })
}

function handlePostShortcutClick(e: MouseEvent) {
  if (!(e.target instanceof Element)) {
    return
  }

  if (e.target.closest('#post-top-button')) {
    scrollToTarget('#post-top-anchor')
    return
  }

  if (e.target.closest('#post-comment-button')) {
    scrollToTarget('#post-comments')
  }
}

const PROGRESS_CIRCUMFERENCE = 2 * Math.PI * 15.5
let progressTicking = false
let scrollAnchor = 0

function updateTopProgress() {
  progressTicking = false
  const circle = document.querySelector<SVGCircleElement>('#post-top-button [data-top-progress]')
  if (!circle) {
    return
  }

  const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight)
  const position = Math.max(0, Math.min(maxScroll, window.scrollY))
  const delta = position - scrollAnchor
  if (position < 48 || Math.abs(delta) >= 10) {
    document.documentElement.toggleAttribute('data-reading-controls-hidden', position >= 48 && delta > 0)
    scrollAnchor = position
  }
  const progress = maxScroll > 0
    ? Math.min(1, Math.max(0, window.scrollY / maxScroll))
    : 0
  const offset = PROGRESS_CIRCUMFERENCE * (1 - progress)

  circle.style.strokeDasharray = `${PROGRESS_CIRCUMFERENCE}`
  circle.style.strokeDashoffset = `${offset}`
}

function handleProgressScroll() {
  if (!progressTicking) {
    window.requestAnimationFrame(updateTopProgress)
    progressTicking = true
  }
}

function setupPostProgress() {
  progressTicking = false
  scrollAnchor = window.scrollY
  document.documentElement.removeAttribute('data-reading-controls-hidden')
  updateTopProgress()
}

document.addEventListener('click', handlePostShortcutClick)
document.addEventListener('scroll', handleProgressScroll, { passive: true })
window.addEventListener('resize', handleProgressScroll, { passive: true })
document.addEventListener('astro:page-load', setupPostProgress)

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', setupPostProgress, { once: true })
}
else {
  setupPostProgress()
}
</script>

<style>
  .floating-utility-button {
    width: 1rem;
    height: 1rem;
    display: inline-grid;
    place-items: center;
    flex: none;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    line-height: 1;
    cursor: pointer;
    transition:
      color var(--motion-fast, 160ms) ease,
      transform var(--motion-fast, 160ms) var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .floating-utility-button:hover {
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .floating-utility-button:active {
    transform: scale(0.9);
  }

  .floating-utility-button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
    border-radius: 50%;
  }

  .floating-utility-button__icon {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  .floating-utility-button--ring {
    width: 2.35rem;
    height: 2.35rem;
  }

  .floating-utility-button__ring-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 1023.98px) {
    #site-utility {
      right: calc(var(--controls-edge) + env(safe-area-inset-right));
      bottom: var(--controls-bottom);
      gap: 0;
      border: var(--control-border);
      border-radius: var(--control-radius);
      background: var(--control-surface);
    }

    .floating-utility-button {
      width: var(--control-size);
      height: var(--control-size);
      border-radius: var(--control-radius);
    }

    .floating-utility-button__ring-svg {
      width: 1.45rem;
      height: 1.45rem;
    }

    #site-utility.site-utility--single {
      gap: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    #site-utility.site-utility--single .floating-utility-button {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
    }

    .floating-utility-button:hover {
      background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.08);
    }

    .floating-utility-button:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 1px;
    }
  }

</style>
