---
import SortableDate from '@/components/SortableDate.astro'
import { themeConfig } from '@/config'
import { ui } from '@/i18n/ui'
import { formatPostDate } from '@/utils/date'
import { getPageInfo } from '@/utils/page'

interface Props {
  date: Date
  updatedDate?: Date
  minutes: number
  sortable?: boolean
}

const { date, updatedDate, minutes, sortable = false } = Astro.props
const { dateFormat: format } = themeConfig.global
const { currentLang, isPost } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const timeSpacingClass = isPost ? 'ml-1.75' : 'ml-1.5'

// 同一天内的修订不算“更新”
const showUpdated = !sortable && updatedDate
  && formatPostDate(updatedDate, 'YYYY-MM-DD') !== formatPostDate(date, 'YYYY-MM-DD')
const readingLabel = currentUI.readingMinutes?.replace('{COUNT}', String(minutes)) ?? `${minutes} min`

---

<!-- published date -->
{sortable
  ? <SortableDate {date} {updatedDate} {format} />
  : <time datetime={date.toISOString().split('T')[0]}>{formatPostDate(date, format)}</time>}

<!-- updated date -->
{showUpdated && updatedDate && (
  <time
    datetime={updatedDate.toISOString().split('T')[0]}
    class={timeSpacingClass}
  >
    {currentUI.updatedAt?.replace('{DATE}', formatPostDate(updatedDate, format)) ?? `updated ${formatPostDate(updatedDate, format)}`}
  </time>
)}

<!-- reading time -->
<span class={timeSpacingClass}>
  {readingLabel}
</span>
