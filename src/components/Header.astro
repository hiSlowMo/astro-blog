---
import { themeConfig } from '@/config'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang, getLocalizedPath, isPost } = getPageInfo(Astro.url.pathname)
const { title, subtitle, i18nTitle, status } = themeConfig.site

const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const headerTitle = i18nTitle ? currentUI.title : title
const headerSubtitle = i18nTitle ? currentUI.subtitle : subtitle
const statusMessages = status
  ? Array.isArray(status.text) ? status.text : [status.text]
  : []

const TitleTag = isPost ? 'h2' : 'h1'
const SubtitleTag = isPost ? 'div' : 'h2'
---

<header
  id="site-header"
  class:list={[
    'lg:(uno-desktop-column top-20) cjk:tracking-wide',
    isPost
    ? 'mb-6.6 lg:mb-10.8'
    : 'mb-10.5',
  ]}
>
  <TitleTag
    class:list={[
      'font-bold font-title',
      isPost
        ? `mb-1.5 mt-1.2 text-5.375 c-secondary lg:(mb-1.8 mt-0 text-9 c-primary)`
        : `mb-1.8 text-8 c-primary cjk:break-keep lg:text-9`,
    ]}
  >
    <!-- Fix text cropping issues during view transition on iOS by adding a div tag -->
    <div
      class="box-content inline-block pr-1"
      transition:name={`site-title-${currentLang}`}
      data-disable-theme-toggle-transition
    >
      <a
        id="site-title-link"
        href={getLocalizedPath('/')}
      >
          {headerTitle}
      </a>
    </div>
  </TitleTag>

  {headerSubtitle && (
    <SubtitleTag
      class:list={[
        'whitespace-pre-line text-3.5 c-secondary font-navbar lg:text-4',
        isPost
        ? 'hidden lg:block'
        : 'w-75% lg:w-full',
      ]}
      aria-hidden={isPost}
    >
      {headerSubtitle}
    </SubtitleTag>
  )}

  {status && (
    <p
      class:list={[
        'site-status mt-3 items-center gap-2 text-3 font-time lg:(mt-4 text-3.25)',
        isPost ? 'hidden lg:flex' : 'flex',
      ]}
      data-tone={status.tone ?? 'online'}
      data-status-messages={JSON.stringify(statusMessages)}
      data-status-interval={status.interval ?? 3200}
      id="site-status"
    >
      <span class="site-status-dot" aria-hidden="true" />
      <span class="site-status-text" aria-live="off">{statusMessages[0]}</span>
    </p>
  )}
</header>

<script>
const statusTimers = new WeakMap<HTMLElement, number>()
const statusSwapTimers = new WeakMap<HTMLElement, number>()

function clearStatusTimers(status: HTMLElement) {
  const timer = statusTimers.get(status)
  const swapTimer = statusSwapTimers.get(status)

  if (timer) {
    window.clearTimeout(timer)
    statusTimers.delete(status)
  }

  if (swapTimer) {
    window.clearTimeout(swapTimer)
    statusSwapTimers.delete(status)
  }
}

function initRotatingStatus() {
  const status = document.querySelector<HTMLElement>('#site-status')
  const text = status?.querySelector<HTMLElement>('.site-status-text')
  if (!status || !text) {
    return
  }

  clearStatusTimers(status)

  let messages: string[] = []
  try {
    messages = JSON.parse(status.dataset.statusMessages ?? '[]')
  }
  catch {
    return
  }

  if (messages.length < 2) {
    return
  }

  const interval = Math.min(
    10_000,
    Math.max(1_800, Number(status.dataset.statusInterval) || 3200),
  )
  const swapDuration = 180
  let index = 0
  const currentStatus = status
  const currentText = text

  function scheduleNext() {
    statusTimers.set(currentStatus, window.setTimeout(rotate, interval))
  }

  function rotate() {
    const reduceMotion = document.documentElement.classList.contains('reduce-motion')
      || window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (reduceMotion || document.visibilityState === 'hidden') {
      scheduleNext()
      return
    }

    index = (index + 1) % messages.length
    currentText.classList.add('is-leaving')

    statusSwapTimers.set(currentStatus, window.setTimeout(() => {
      currentText.textContent = messages[index] ?? messages[0]
      currentText.classList.remove('is-leaving')
      currentText.classList.add('is-entering')

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => currentText.classList.remove('is-entering'))
      })

      scheduleNext()
    }, swapDuration))
  }

  scheduleNext()
}

document.addEventListener('astro:before-swap', () => {
  const status = document.querySelector<HTMLElement>('#site-status')
  if (status) {
    clearStatusTimers(status)
  }
})
document.addEventListener('astro:page-load', initRotatingStatus)
</script>

<style>
  .site-status {
    --status-color: oklch(var(--un-preset-theme-colors-accent));
  }
  .site-status[data-tone='away'] {
    --status-color: oklch(66% 0.14 70);
  }
  :global(html.dark) .site-status[data-tone='away'] {
    --status-color: oklch(80% 0.14 80);
  }
  .site-status[data-tone='offline'] {
    --status-color: oklch(var(--un-preset-theme-colors-secondary) / 0.5);
  }

  .site-status-dot {
    position: relative;
    flex: none;
    width: 0.45rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--status-color);
  }

  /* online: ping ripple, away: slow breathing, offline: static */
  .site-status-dot::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    content: '';
    animation: site-status-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .site-status:not([data-tone='online']) .site-status-dot::after {
    display: none;
  }
  .site-status[data-tone='away'] .site-status-dot {
    animation: site-status-breathe 3.2s ease-in-out infinite;
  }

  .site-status-text {
    display: inline-block;
    transform-origin: left center;
    transition:
      opacity 180ms ease,
      transform 180ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 180ms ease;
  }
  .site-status-text.is-leaving {
    opacity: 0;
    filter: blur(2px);
    transform: translateY(-0.32em);
  }
  .site-status-text.is-entering {
    opacity: 0;
    filter: blur(2px);
    transform: translateY(0.32em);
    transition: none;
  }

  @keyframes site-status-ping {
    75%,
    100% {
      opacity: 0;
      scale: 2.6;
    }
  }

  @keyframes site-status-breathe {
    50% {
      opacity: 0.35;
    }
  }

  :global(html.reduce-motion) .site-status-dot,
  :global(html.reduce-motion) .site-status-dot::after,
  :global(html.reduce-motion) .site-status-text {
    animation: none;
    filter: none;
    transform: none;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-status-dot,
    .site-status-dot::after,
    .site-status-text {
      animation: none;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>
