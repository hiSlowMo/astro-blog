---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import PinIcon from '@/assets/icons/pin-icon.svg'
import SortableDate from '@/components/SortableDate.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import { getPostPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import { getPostDescription } from '@/utils/description'

export interface Props {
  posts: Post[]
  lang: Language
}

const { posts, lang } = Astro.props
---

<ul>
  {posts.map((post) => {
    const slug = post.data.abbrlink || post.id
    const categories = post.data.categories ?? []

    return (
      <li
        class="post-item mb-4 lg:mb-6"
        data-categories={categories.join(',')}
        data-created={post.data.published.valueOf()}
        data-updated={(post.data.updated ?? post.data.published).valueOf()}
      >
        <div
          class="post-date font-time"
          transition:name={`time-${slug}${lang ? `-${lang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          <span class="post-date-full">
            <SortableDate date={post.data.published} updatedDate={post.data.updated} format="YYYY-MM-DD" />
          </span>
          <span class="post-date-short">
            <SortableDate date={post.data.published} updatedDate={post.data.updated} format="MM.DD" />
          </span>
        </div>
        <div class="post-copy">
          <h3>
            <a
              class="module-title text-pretty"
              href={getPostPath(slug, lang)}
              transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
              data-disable-theme-toggle-transition
            >
              {post.data.title}
            </a>
          </h3>
          <div class="post-meta font-time">
            <span>{ui[lang].readingMinutes.replace('{COUNT}', String(post.remarkPluginFrontmatter.minutes))}</span>
            {(post.data.pin ?? 0) > 0 && (
              <PinIcon aria-hidden="true" class="w-1em" fill="currentColor" />
            )}
            {post.data.status && <StatusBadge status={post.data.status} dotOnly />}
          </div>
          <div class="heti post-summary mt-1 hidden sm:block">
            <p>{getPostDescription(post, 'list')}</p>
          </div>
        </div>
      </li>
    )
  })}
</ul>

<style>
  .post-item {
    display: grid;
    grid-template-columns: var(--editorial-index) minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--editorial-gap);
  }

  .post-date, .post-meta {
    color: oklch(var(--un-preset-theme-colors-secondary));
    font-size: .85rem;
  }

  .post-date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .post-copy {
    overflow-wrap: anywhere;
  }

  .post-date-short {
    display: none;
  }

  @media (max-width: 768px) {
    .post-item {
      grid-template-columns: clamp(64px, 12vw, 72px) minmax(0, 1fr);
    }

    .post-date-full {
      display: none;
    }

    .post-date-short {
      display: inline;
    }
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: .4rem;
    margin-top: .15rem;
  }

  .post-summary :global(p) {
    color: oklch(var(--un-preset-theme-colors-secondary) / .86);
    font-weight: 400;
  }
</style>
