<script>
let overlay: HTMLDivElement | null = null
let closeButton: HTMLButtonElement | null = null
let zoomedImg: HTMLImageElement | null = null
let originalImg: HTMLImageElement | null = null

function prefersReducedMotion() {
  return document.documentElement.classList.contains('reduce-motion')
    || window.matchMedia('(prefers-reduced-motion: reduce)').matches
}

function setupOverlay() {
  if (overlay?.isConnected)
    return

  overlay = document.createElement('div')
  overlay.className = 'zoom-overlay'
  overlay.setAttribute('role', 'dialog')
  overlay.setAttribute('aria-modal', 'true')
  overlay.setAttribute('aria-label', '图片预览')

  closeButton = document.createElement('button')
  closeButton.type = 'button'
  closeButton.className = 'zoom-close'
  closeButton.setAttribute('aria-label', '关闭图片预览')
  closeButton.textContent = '×'

  document.body.appendChild(overlay)
  document.body.appendChild(closeButton)
}

function setupImages() {
  document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => {
    if (img.dataset.zoomReady === '1' || img.closest('a, button'))
      return

    img.dataset.zoomReady = '1'
    img.tabIndex = 0
    img.setAttribute('role', 'button')
    img.setAttribute('aria-label', img.alt ? `放大图片：${img.alt}` : '放大图片')
  })
}

function isZoomable(img: HTMLImageElement) {
  return img.dataset.zoomReady === '1'
    && img.complete
    && img.width >= 100
    && img.height >= 100
}

function zoomIn(img: HTMLImageElement) {
  if (!overlay || zoomedImg || !isZoomable(img))
    return

  document.body.style.overflow = 'hidden'
  const rect = img.getBoundingClientRect()
  originalImg = img

  zoomedImg = img.cloneNode() as HTMLImageElement
  zoomedImg.className = 'zoom-img'
  zoomedImg.removeAttribute('id')
  zoomedImg.removeAttribute('loading')
  zoomedImg.removeAttribute('tabindex')
  zoomedImg.removeAttribute('role')
  zoomedImg.removeAttribute('aria-label')
  zoomedImg.removeAttribute('data-zoom-ready')

  zoomedImg.style.top = `${rect.top}px`
  zoomedImg.style.left = `${rect.left}px`
  zoomedImg.style.width = `${rect.width}px`
  zoomedImg.style.height = `${rect.height}px`

  document.body.appendChild(zoomedImg)
  overlay.style.display = 'block'
  if (closeButton) {
    closeButton.style.display = 'grid'
    closeButton.focus()
  }

  const viewportWidth = window.innerWidth
  const viewportHeight = window.innerHeight
  const scaleFactor = viewportWidth < 768 ? 1 : 0.8
  const scale = Math.min(
    (viewportWidth * scaleFactor) / rect.width,
    (viewportHeight * scaleFactor) / rect.height,
  )
  const translateX = (-rect.left + (viewportWidth - rect.width) / 2) / scale
  const translateY = (-rect.top + (viewportHeight - rect.height) / 2) / scale

  requestAnimationFrame(() => {
    if (overlay)
      overlay.style.opacity = '1'

    if (zoomedImg)
      zoomedImg.style.transform = `scale(${scale}) translate3d(${translateX}px, ${translateY}px, 0)`
  })
}

function zoomOut() {
  if (!overlay || !zoomedImg || !originalImg)
    return

  zoomedImg.style.transform = ''
  overlay.style.opacity = '0'
  document.body.style.overflow = ''

  let finished = false
  const cleanup = () => {
    if (finished || !zoomedImg)
      return
    finished = true

    zoomedImg.remove()
    zoomedImg = null

    if (overlay)
      overlay.style.display = 'none'
    if (closeButton)
      closeButton.style.display = 'none'

    if (originalImg?.isConnected)
      originalImg.focus()
    originalImg = null
  }

  if (prefersReducedMotion()) {
    cleanup()
    return
  }

  zoomedImg.addEventListener('transitionend', cleanup, { once: true })
  window.setTimeout(cleanup, 350)
}

function handleClick(event: MouseEvent) {
  if (zoomedImg) {
    zoomOut()
    return
  }

  const target = event.target
  if (!(target instanceof HTMLImageElement) || !isZoomable(target))
    return

  event.preventDefault()
  zoomIn(target)
}

function handleKeydown(event: KeyboardEvent) {
  if (zoomedImg) {
    if (event.key === 'Escape') {
      event.preventDefault()
      zoomOut()
    }
    else if (event.key === 'Tab') {
      event.preventDefault()
      closeButton?.focus()
    }
    return
  }

  const target = event.target
  if (!(target instanceof HTMLImageElement) || !isZoomable(target))
    return

  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault()
    zoomIn(target)
  }
}

function handlePageLoad() {
  setupOverlay()
  setupImages()
}

function handleBeforeSwap() {
  zoomedImg?.remove()
  zoomedImg = null
  originalImg = null
  overlay?.remove()
  overlay = null
  closeButton?.remove()
  closeButton = null
  document.body.style.overflow = ''
}

document.addEventListener('astro:page-load', handlePageLoad)
document.addEventListener('astro:before-swap', handleBeforeSwap)
document.addEventListener('click', handleClick)
document.addEventListener('keydown', handleKeydown)
window.addEventListener('resize', zoomOut)

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', handlePageLoad, { once: true })
}
else {
  handlePageLoad()
}
</script>
