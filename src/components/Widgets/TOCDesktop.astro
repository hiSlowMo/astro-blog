---
import type { TocPanelProps } from '@/components/Widgets/toc-shared'
import TocIcon from '@/assets/icons/toc-icon.svg'
import { buildTocTree } from '@/components/Widgets/toc-shared'
import TocTreeList from '@/components/Widgets/TocTreeList.astro'

const {
  filteredHeadings,
  seriesItems,
  currentUI,
  hasToc,
  hasSeries,
} = Astro.props as TocPanelProps

const tocTree = buildTocTree(filteredHeadings)
---

<aside
  id="toc-container"
  data-has-series={hasSeries ? '1' : '0'}
  class="mb-6 hidden bg-secondary/5 min-[1100px]:(fixed top-32 block max-w-[min(calc(50vw-23.5rem),15.2rem)] border-none bg-secondary/0)"
>
  {hasToc && (
    <>
      <div class="toc-heading-row">
        <button
          type="button"
          class="toc-toggle-label toc-icon-button"
          data-toc-disclosure
          aria-controls="toc-accordion-wrapper"
          aria-expanded="false"
          aria-label="展开目录"
        >
          <TocIcon width="18" height="18" fill="currentColor" aria-hidden="true" />
          <span class="sr-only">{currentUI.toc}</span>
        </button>
      </div>

      <div id="toc-accordion-wrapper" class="toc-disclosure-body" data-open="0" aria-hidden="true" inert>
        <div class="toc-disclosure-clip">
          <nav
            id="toc-accordion-content"
            aria-label="Table of Contents"
          >
            <TocTreeList
              id="toc-links-list"
              nodes={tocTree}
            />
          </nav>
        </div>
      </div>
    </>
  )}

  {hasSeries && (
    <section
      id="post-series-section"
      class:list={[
        'post-series',
        hasToc ? 'post-series--with-toc' : 'post-series--standalone',
      ]}
    >
      <div class="toc-heading-row">
        <button
          type="button"
          data-toc-disclosure
          aria-controls="series-accordion-wrapper"
          aria-expanded="true"
          aria-label="收起系列文章"
          class="toc-toggle-label"
        >
          <span class="post-series-heading">{currentUI.series}</span>
        </button>
      </div>
      <div id="series-accordion-wrapper" class="toc-disclosure-body" data-open="1">
        <div class="toc-disclosure-clip">
          <div id="series-accordion-content">
            <ol id="series-links-list" class="no-heti series-tree">
              {seriesItems.map(item => (
                <li class="series-tree-item">
                  <a
                    href={item.href}
                    title={`${item.date} · ${item.title}`}
                    class:list={[
                      'no-heti series-tree-link',
                      item.isCurrent ? 'is-current' : '',
                    ]}
                    aria-current={item.isCurrent ? 'page' : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>
  )}
</aside>

<style>
  #toc-container {
    --toc-fade-duration: 320ms;
    --toc-side-offset: clamp(0.9rem, 1.35vw, 1.6rem);
  }

  @media (min-width: 1100px) {
    #toc-container {
      left: max(var(--toc-side-offset), calc(50vw - 38rem));
    }
  }

  .toc-heading-row {
    margin-bottom: 0.15rem;
  }

  .toc-toggle-label {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0;
    border: none;
    background: transparent;
    color: oklch(var(--un-preset-theme-colors-primary));
    cursor: pointer;
    transition: opacity var(--motion-fast, 160ms) ease;
  }

  .toc-toggle-label:not(.toc-icon-button):hover {
    opacity: 0.82;
  }

  .toc-toggle-label:focus-visible {
    outline: 2px solid oklch(var(--un-preset-theme-colors-accent));
    outline-offset: 3px;
  }

  .toc-icon-button {
    min-width: 2rem;
    min-height: 2rem;
    justify-content: center;
    margin-inline-start: calc((18px - 2rem) / 2);
    color: color-mix(in oklab, oklch(var(--un-preset-theme-colors-primary)) 55%, oklch(var(--un-preset-theme-colors-background)));
    transition: color var(--toc-fade-duration) linear;
  }

  .toc-icon-button:is([aria-expanded='true'], :hover, :focus-visible) {
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .post-series-heading {
    font-family: var(--font-sans);
    font-size: 1.22rem;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  #toc-accordion-content {
    max-height: calc(100vh - 12rem);
    padding: 0 0.25rem 0 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: oklch(var(--un-preset-theme-colors-secondary) / 0.15) transparent;
  }

  @media (min-width: 1100px) {
    #toc-container[data-has-series='1'] #toc-accordion-content {
      max-height: calc(48vh - 4.5rem);
    }
  }

  #toc-accordion-content::-webkit-scrollbar,
  #series-accordion-content::-webkit-scrollbar {
    --at-apply: 'hidden';
  }

  .post-series {
    --at-apply: 'pb-0';
  }

  .post-series--with-toc {
    margin-top: 1.1rem;
    padding-top: 0.85rem;
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.14);
  }

  .post-series--standalone {
    --at-apply: 'pt-0';
  }

  #series-accordion-content {
    max-height: calc(38vh - 4.5rem);
    padding: 0 0.25rem 0 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: oklch(var(--un-preset-theme-colors-secondary) / 0.15) transparent;
  }

  .series-tree {
    list-style: none !important;
    margin: 0.2rem 0 0 !important;
    padding: 0 0 0 0.25rem !important;
    font-family: var(--font-sans);
  }

  .series-tree-item {
    position: relative;
    margin: 0 !important;
    padding: 0.2rem 0 0.2rem 0.75rem !important;
    list-style: none !important;
    line-height: 1.45;
  }

  .series-tree-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.48);
    pointer-events: none;
  }

  .series-tree-item:first-child::before {
    top: -0.22rem;
  }

  .series-tree-item:last-child::before {
    bottom: auto;
    height: 0.92rem;
  }

  .series-tree-item:first-child:last-child::before {
    height: 1.14rem;
  }

  .series-tree-item::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.92rem;
    width: 0.5rem;
    height: 1px;
    background-color: oklch(var(--un-preset-theme-colors-secondary) / 0.48);
    pointer-events: none;
  }

  .series-tree-link {
    display: block;
    max-width: 100%;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-decoration: none !important;
    font-size: 0.9375rem;
    line-height: 1.45;
    font-weight: 400;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.58);
    transition:
      color var(--motion-fast, 160ms) ease-out,
      font-weight var(--motion-fast, 160ms) ease-out;
  }

  .series-tree-link::after {
    display: none !important;
  }

  .series-tree-link:hover {
    color: oklch(var(--un-preset-theme-colors-primary) / 0.9);
  }

  .series-tree-link.is-current {
    color: oklch(var(--un-preset-theme-colors-primary));
    font-weight: 700;
  }

  .series-tree-item:has(> .series-tree-link.is-current)::after {
    height: 2px;
    background-color: oklch(var(--un-preset-theme-colors-accent));
  }

  .toc-disclosure-body {
    display: grid;
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 260ms var(--motion-ease-standard), visibility 0s;
  }

  .toc-disclosure-body[data-open='0'] {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 260ms var(--motion-ease-standard), visibility 0s linear 260ms;
  }

  .toc-disclosure-clip {
    min-height: 0;
    overflow: hidden;
  }

  #toc-accordion-wrapper {
    transition: grid-template-rows 0s, visibility 0s;
  }

  #toc-accordion-wrapper[data-open='0'] {
    --toc-hidden-ink: oklch(var(--un-preset-theme-colors-background));
    transition-delay: var(--toc-fade-duration);
  }

  @media (prefers-reduced-motion: reduce) {
    #toc-container {
      --toc-fade-duration: 0s;
    }
    .toc-icon-button,
    #toc-accordion-wrapper,
    #series-accordion-wrapper {
      transition: none;
    }
  }

  :global(html.reduce-motion) #toc-container {
    --toc-fade-duration: 0s;
  }

  :global(html.reduce-motion) .toc-icon-button,
  :global(html.reduce-motion) #toc-accordion-wrapper,
  :global(html.reduce-motion) #series-accordion-wrapper {
    transition: none;
  }
</style>

<script>
const isDesktopToc = window.matchMedia('(min-width: 1100px)')

let ticking = false
let activeSlug = ''
let headingOffset = 0
let headingEntries: Array<{ slug: string, el: HTMLElement }> = []
let linksBySlug = new Map<string, HTMLAnchorElement[]>()
let disclosureController: AbortController | undefined

function setupDisclosures() {
  disclosureController?.abort()
  disclosureController = new AbortController()
  const { signal } = disclosureController
  document.querySelectorAll<HTMLButtonElement>('#toc-container [data-toc-disclosure]').forEach((button) => {
    const panel = document.getElementById(button.getAttribute('aria-controls') || '')
    if (!panel)
      return
    const setOpen = (open: boolean) => {
      panel.dataset.open = open ? '1' : '0'
      button.setAttribute('aria-expanded', String(open))
      button.setAttribute('aria-label', `${open ? '收起' : '展开'}${button.textContent?.trim()}`)
      panel.setAttribute('aria-hidden', String(!open))
      panel.inert = !open
    }

    let pinned = false
    button.addEventListener('click', () => {
      pinned = panel.dataset.open !== '1'
      setOpen(pinned)
    }, { signal })

    const article = button.closest('article')
    if (panel.id !== 'toc-accordion-wrapper' || !article)
      return
    let openedOnHover = false
    let lastX: number | undefined
    let lastY: number | undefined
    document.addEventListener('pointermove', (event) => {
      if (!isDesktopToc.matches || event.pointerType !== 'mouse' || (event.clientX === lastX && event.clientY === lastY))
        return
      lastX = event.clientX
      lastY = event.clientY
      if (openedOnHover || !(event.target instanceof Node) || !article.contains(event.target))
        return
      openedOnHover = true
      setOpen(true)
    }, { signal })
    article.addEventListener('pointerleave', () => {
      openedOnHover = false
      if (!pinned && !article.matches(':focus-within'))
        setOpen(false)
    }, { signal })
    article.addEventListener('focusin', (event) => {
      if (isDesktopToc.matches && event.target instanceof Element && !event.target.closest('#toc-container'))
        setOpen(true)
    }, { signal })
    article.addEventListener('focusout', (event) => {
      if (!pinned && !article.matches(':hover') && !(event.relatedTarget instanceof Node && article.contains(event.relatedTarget)))
        setOpen(false)
    }, { signal })
    isDesktopToc.addEventListener('change', () => {
      pinned = false
      setOpen(false)
    }, { signal })
  })
}

function collectTocEntries() {
  headingEntries = []
  linksBySlug = new Map()

  const allTocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
  const seenSlugs = new Set<string>()

  allTocLinks.forEach((link) => {
    link.removeAttribute('aria-current')
    const slug = link.dataset.tocSlug
    if (!slug)
      return

    const list = linksBySlug.get(slug) ?? []
    list.push(link)
    linksBySlug.set(slug, list)

    if (!seenSlugs.has(slug)) {
      seenSlugs.add(slug)
      const headingEl = document.getElementById(slug)
      if (headingEl) {
        headingEntries.push({ slug, el: headingEl })
      }
    }
  })
  measureHeadingOffset()
}

function measureHeadingOffset() {
  const first = headingEntries[0]
  headingOffset = first ? parseFloat(getComputedStyle(first.el).scrollMarginTop) || 0 : 0
}

function updateActiveTocLinks() {
  if (headingEntries.length === 0) {
    ticking = false
    return
  }

  ticking = false
  let current = headingEntries[0]
  for (const entry of headingEntries) {
    if (entry.el.getBoundingClientRect().top > headingOffset + 1)
      break
    current = entry
  }

  if (current.slug === activeSlug)
    return
  linksBySlug.get(activeSlug)?.forEach(link => link.removeAttribute('aria-current'))
  activeSlug = current.slug
  const links = linksBySlug.get(activeSlug) ?? []
  links.forEach(link => link.setAttribute('aria-current', 'location'))
  const firstActiveLink = links.find(link => link.closest('#toc-links-list'))
  if (isDesktopToc.matches && firstActiveLink) {
    const nav = firstActiveLink.closest<HTMLElement>('#toc-accordion-content')
    if (nav) {
      const linkRect = firstActiveLink.getBoundingClientRect()
      const navRect = nav.getBoundingClientRect()
      if (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom)
        nav.scrollTop += linkRect.top - navRect.top - nav.clientHeight / 2 + linkRect.height / 2
    }
  }
}

function handleScroll() {
  if (!ticking) {
    window.requestAnimationFrame(updateActiveTocLinks)
    ticking = true
  }
}

function handleResize() {
  measureHeadingOffset()
  handleScroll()
}

function setupAutoScroll() {
  setupDisclosures()
  ticking = false
  activeSlug = ''
  collectTocEntries()

  if (headingEntries.length === 0) {
    return
  }

  updateActiveTocLinks()
  document.addEventListener('scroll', handleScroll, { passive: true })
  window.addEventListener('resize', handleResize, { passive: true })
}

function cleanupAutoScroll() {
  disclosureController?.abort()
  disclosureController = undefined
  document.removeEventListener('scroll', handleScroll)
  window.removeEventListener('resize', handleResize)
  ticking = false
  activeSlug = ''
  headingEntries = []
  linksBySlug.clear()
}

document.addEventListener('astro:page-load', setupAutoScroll)
document.addEventListener('astro:before-swap', cleanupAutoScroll)

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', setupAutoScroll, { once: true })
}
else {
  setupAutoScroll()
}
</script>
