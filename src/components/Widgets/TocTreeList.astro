---
import type { TocTreeNode } from '@/components/Widgets/toc-shared'

interface Props {
  nodes: TocTreeNode[]
  id?: string
}

const { nodes, id } = Astro.props
---

<ul id={id} class="no-heti toc-tree">
  {nodes.map(node => (
    <li>
      <a href={`#${node.slug}`} data-toc-link data-toc-slug={node.slug} class="no-heti toc-tree-link">
        {node.text}
      </a>
      {node.children.length > 0 && <Astro.self nodes={node.children} />}
    </li>
  ))}
</ul>

<style>
  .toc-tree {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
  }

  .toc-tree .toc-tree {
    padding-inline-start: .85rem;
  }

  .toc-tree-link {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding-block: .23rem;
    color: var(--toc-hidden-ink, var(--text-meta, oklch(var(--un-preset-theme-colors-secondary))));
    font-size: .875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--toc-hidden-ink, var(--section-rule));
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
    transition: color var(--toc-fade-duration, var(--motion-fast)) linear, text-decoration-color var(--toc-fade-duration, var(--motion-fast)) linear;
  }

  .toc-tree-link:is(:hover, :focus-visible, [aria-current='location']) {
    color: var(--toc-hidden-ink, oklch(var(--un-preset-theme-colors-primary)));
    text-decoration-color: currentColor;
  }

  .toc-tree-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -1px;
  }
</style>
