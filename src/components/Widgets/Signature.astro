---
import SignatureSVG from '@/assets/signature.svg?raw'

interface Props {
  mode?: 'loop' | 'once-on-view'
  loopPause?: number
  threshold?: number
}

const { mode = 'once-on-view', loopPause = 8000, threshold = 0.6 } = Astro.props
---

<div
  class="signature-wrapper"
  data-mode={mode}
  data-loop-pause={loopPause}
  data-threshold={threshold}
  data-signature-state="pending"
  role="img"
  aria-label="SlowMo 手写签名"
>
  <Fragment set:html={SignatureSVG} />
</div>
<noscript>
  <style>
    .signature-wrapper[data-signature-state='pending'] [data-ink] { stroke-dashoffset: 0; }
  </style>
</noscript>

<script>
  import { prefersReducedMotion } from '@/scripts/motion'

  type SignatureElement = HTMLElement & { __signatureCleanup?: () => void }

  function setupSignature(wrapper: SignatureElement) {
    if (wrapper.__signatureCleanup)
      return

    const paths = Array.from(wrapper.querySelectorAll<SVGPathElement>('[data-ink]'))
    const mistake = wrapper.querySelector<SVGPathElement>('[data-mistake]')
    if (!paths.length || !mistake)
      return

    const controller = new AbortController()
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)')
    const totalDuration = 2720
    const penEasing = 'cubic-bezier(0.35, 0, 0.25, 1)'
    let animations: Animation[] = []
    let loopTimer: ReturnType<typeof setTimeout> | undefined
    let started = false

    const cancelAnimations = () => {
      clearTimeout(loopTimer)
      animations.forEach(animation => animation.cancel())
      animations = []
    }

    const showFinished = () => {
      cancelAnimations()
      wrapper.dataset.signatureState = 'finished'
    }

    // All strokes share one timeline, including the brief wrong turn and its reverse.
    // This keeps the pen rhythm together even when the browser throttles a background tab.
    const play = () => {
      if (prefersReducedMotion()) {
        showFinished()
        return
      }
      cancelAnimations()
      wrapper.dataset.signatureState = 'writing'
      animations = paths.map((path) => {
        const start = Number(path.dataset.start) / totalDuration
        const end = start + Number(path.dataset.duration) / totalDuration
        return path.animate([
          { strokeDashoffset: '1', opacity: 0, offset: 0 },
          { strokeDashoffset: '1', opacity: 0, offset: start },
          { strokeDashoffset: '1', opacity: 1, offset: start + 0.001, easing: penEasing },
          { strokeDashoffset: '0', opacity: 1, offset: end },
          { strokeDashoffset: '0', opacity: 1, offset: 1 },
        ], { duration: totalDuration, fill: 'forwards' })
      })
      animations.push(mistake.animate([
        { strokeDashoffset: '1', opacity: 0, offset: 0 },
        { strokeDashoffset: '1', opacity: 0, offset: 900 / totalDuration },
        { strokeDashoffset: '1', opacity: 1, offset: 903 / totalDuration, easing: penEasing },
        { strokeDashoffset: '0', opacity: 1, offset: 1050 / totalDuration },
        { strokeDashoffset: '0', opacity: 1, offset: 1190 / totalDuration, easing: penEasing },
        { strokeDashoffset: '1', opacity: 1, offset: 1340 / totalDuration },
        { strokeDashoffset: '1', opacity: 0, offset: 1343 / totalDuration },
        { strokeDashoffset: '1', opacity: 0, offset: 1 },
      ], { duration: totalDuration, fill: 'forwards' }))

      void animations[0].finished.then(() => {
        if (controller.signal.aborted)
          return
        showFinished()
        if (wrapper.dataset.mode === 'loop')
          loopTimer = setTimeout(play, Number(wrapper.dataset.loopPause))
      }).catch(() => {}) // Cancellation is expected when navigating away or reducing motion.
    }

    const observer = new IntersectionObserver((entries) => {
      if (entries.some(entry => entry.isIntersecting) && !started) {
        started = true
        observer.disconnect()
        play()
      }
    }, { threshold: Number(wrapper.dataset.threshold) })

    motionPreference.addEventListener('change', () => {
      if (prefersReducedMotion()) {
        observer.disconnect()
        showFinished()
      }
    }, { signal: controller.signal })

    wrapper.__signatureCleanup = () => {
      observer.disconnect()
      controller.abort()
      showFinished()
      delete wrapper.__signatureCleanup
    }

    if (prefersReducedMotion())
      showFinished()
    else
      observer.observe(wrapper)
  }

  function initSignatures() {
    document.querySelectorAll<SignatureElement>('.signature-wrapper').forEach(setupSignature)
  }

  document.addEventListener('astro:page-load', initSignatures)
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<SignatureElement>('.signature-wrapper').forEach(wrapper => wrapper.__signatureCleanup?.())
  })
  initSignatures()
</script>

<style is:global>
  .signature-wrapper {
    width: 9.5rem;
    margin: 2.25rem 0 0 auto;
    color: oklch(var(--un-preset-theme-colors-primary) / 0.82);
  }

  .signature-wrapper svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .signature-wrapper path {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }

  .signature-wrapper [data-mistake] {
    opacity: 0;
  }

  .signature-wrapper [data-flourish] {
    stroke-opacity: 0.65;
  }

  .signature-wrapper[data-signature-state='pending'] [data-ink],
  .signature-wrapper[data-signature-state='writing'] [data-ink] {
    stroke-dashoffset: 1;
  }

  html.reduce-motion .signature-wrapper [data-ink] {
    stroke-dashoffset: 0 !important;
    opacity: 1 !important;
  }

  html.reduce-motion .signature-wrapper [data-mistake] {
    opacity: 0 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-wrapper [data-ink] {
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }

    .signature-wrapper [data-mistake] {
      opacity: 0 !important;
    }
  }
</style>
