---
import 'lite-youtube-embed/src/lite-yt-embed.css'
---

<script>
// Load YouTube embed script
async function setupYouTubeEmbeds() {
  const youtube = document.querySelectorAll('lite-youtube')
  if (youtube.length === 0) {
    return
  }

  try {
    // @ts-expect-error - No type definitions available for lite-youtube-embed
    await import('lite-youtube-embed')
  }
  catch (error) {
    console.error('[MediaEmbed] Failed to load YouTube embed:', error)
  }
}

// Initialize Twitter widgets
async function setupTweetEmbeds() {
  const tweets = document.querySelectorAll('.twitter-tweet')
  if (tweets.length === 0) {
    return
  }

  tweets.forEach((tweet) => {
    tweet.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')
  })

  // Inject Twitter script
  const script = document.createElement('script')
  script.src = 'https://platform.twitter.com/widgets.js'
  script.async = true
  document.head.appendChild(script)
}

// Initialize all media embeds
async function setupMediaEmbeds() {
  setupGalleryScrolling()
  await Promise.allSettled([
    setupYouTubeEmbeds(),
    setupTweetEmbeds(),
  ])
}

// Handle horizontal scrolling for gallery
function handleGalleryWheel(e: WheelEvent) {
  const container = e.currentTarget as HTMLElement
  if (e.ctrlKey || Math.abs(e.deltaX) >= Math.abs(e.deltaY)) {
    return
  }

  // Convert vertical scroll to horizontal
  const previousScrollLeft = container.scrollLeft
  const unit = e.deltaMode === WheelEvent.DOM_DELTA_LINE
    ? 16
    : e.deltaMode === WheelEvent.DOM_DELTA_PAGE ? container.clientWidth : 1
  container.scrollLeft += e.deltaY * unit
  if (container.scrollLeft === previousScrollLeft) {
    return
  }

  // Prevent default scroll only if horizontal scroll occurred
  e.preventDefault()
}

let galleryController: AbortController | undefined

function cleanupGalleryScrolling() {
  galleryController?.abort()
  galleryController = undefined
}

function setupGalleryScrolling() {
  cleanupGalleryScrolling()
  const galleries = document.querySelectorAll<HTMLElement>('.gallery-container')
  if (!galleries.length)
    return

  galleryController = new AbortController()
  galleries.forEach(container => container.addEventListener('wheel', handleGalleryWheel, {
    passive: false,
    signal: galleryController!.signal,
  }))
}

document.addEventListener('astro:page-load', setupMediaEmbeds)
document.addEventListener('astro:before-swap', cleanupGalleryScrolling)
</script>
