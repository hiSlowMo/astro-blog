---
import { base } from '@/config'
import { getLangFromLocale } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import searchQueryModule from '@/scripts/search-query.mjs?url'

interface Props {
  autoOpen?: boolean
}

const { autoOpen = false } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui]
const pagefindBase = `${base}/pagefind`
const isProd = import.meta.env.PROD
const messages = {
  loading: '正在搜索…',
  empty: currentUI.searchNoResults,
  count: '{COUNT} 条结果',
  unavailable: '搜索暂时不可用，请稍后重试。',
}
---

<div
  class="search-modal"
  data-search-modal
  data-pagefind-ignore
  aria-hidden="true"
  inert
>
  <div class="search-modal__backdrop" data-search-close />
  <section class="search-modal__dialog" role="dialog" aria-modal="true" aria-label={currentUI.search} tabindex="-1">
    <form class="search-modal__form" role="search">
      <svg class="search-modal__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="7" />
        <path d="m16 16 5 5" stroke-linecap="round" />
      </svg>
      <input
        id="blog-search-input"
        class="search-modal__input"
        type="search"
        aria-label={currentUI.search}
        aria-controls="blog-search-results"
        placeholder={currentUI.searchPlaceholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        disabled={!isProd}
      />
      <button class="search-modal__clear" type="button" aria-label={currentUI.searchClear} data-search-clear hidden>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15" stroke-linecap="round" />
        </svg>
      </button>
      <button class="search-modal__close" type="button" aria-label="关闭搜索" data-search-close><kbd>esc</kbd></button>
    </form>
    <div class="search-modal__results" data-search-results hidden>
      <p class="search-modal__summary" role="status" aria-live="polite" data-search-status />
      <ul id="blog-search-results" class="search-modal__list" />
    </div>
  </section>
</div>

<script type="module" is:inline data-astro-rerun define:vars={{ pagefindBase, searchQueryModule, messages, isProd, autoOpen }}>
(function () {
  const modal = document.querySelector('[data-search-modal]')
  if (!modal)
    return
  globalThis.__blogSearchCleanup?.()

  const controller = new AbortController()
  const { signal } = controller
  const dialog = modal.querySelector('.search-modal__dialog')
  const input = modal.querySelector('input')
  const resultsArea = modal.querySelector('[data-search-results]')
  const list = modal.querySelector('.search-modal__list')
  const status = modal.querySelector('[data-search-status]')
  const clear = modal.querySelector('[data-search-clear]')
  const cache = globalThis.__blogSearchCache ??= new Map()
  const cacheKey = `${pagefindBase}:${document.documentElement.lang}`
  let lastActive = null
  let searchTimer
  let requestId = 0
  let results = []
  let inactiveElements = []
  let preloadTimer

  const isOpen = () => modal.dataset.open === '1'

  async function ensureSearch() {
    if (!isProd)
      return null
    if (!cache.has(cacheKey)) {
      const pending = Promise.all([
        import(`${pagefindBase}/pagefind.js`),
        import(searchQueryModule),
      ]).then(([pagefind, helpers]) => ({
        search: helpers.createBlogSearch(pagefind),
        getTerms: helpers.getSearchTerms,
        highlight: helpers.highlightSearchText,
      })).catch((error) => {
        cache.delete(cacheKey)
        throw error
      })
      cache.set(cacheKey, pending)
    }
    return cache.get(cacheKey)
  }

  function focusInput() {
    if (isOpen())
      (input.disabled ? dialog : input).focus({ preventScroll: true })
  }

  function openModal() {
    if (isOpen())
      return
    lastActive = document.activeElement
    modal.dataset.open = '1'
    modal.setAttribute('aria-hidden', 'false')
    modal.inert = false
    document.documentElement.classList.add('search-modal-open')
    inactiveElements = Array.from(document.body.children)
      .filter(element => element !== modal && !element.contains(modal) && !element.inert)
    inactiveElements.forEach(element => element.inert = true)
    focusInput()
    // Keep parsing/index setup outside the backdrop's first transition.
    clearTimeout(preloadTimer)
    preloadTimer = setTimeout(() => {
      if (isOpen())
        void ensureSearch()?.catch(() => {})
    }, 320)
  }

  function closeModal() {
    if (!isOpen())
      return
    clearTimeout(preloadTimer)
    modal.dataset.open = '0'
    modal.setAttribute('aria-hidden', 'true')
    modal.inert = true
    document.documentElement.classList.remove('search-modal-open')
    inactiveElements.forEach(element => element.inert = false)
    inactiveElements = []
    if (lastActive?.isConnected)
      lastActive.focus({ preventScroll: true })
  }

  function appendHighlight(element, text, terms, highlight) {
    for (const segment of highlight(text, terms)) {
      if (segment.match) {
        const mark = document.createElement('mark')
        mark.textContent = segment.text
        element.append(mark)
      }
      else {
        element.append(document.createTextNode(segment.text))
      }
    }
  }

  function renderResults(items, query, helpers) {
    const fragment = document.createDocumentFragment()
    const terms = helpers.getTerms(query)
    for (const item of items) {
      const li = document.createElement('li')
      const link = document.createElement('a')
      link.className = 'search-modal__result'
      const url = new URL(item.url, location.origin)
      if (url.origin !== location.origin)
        continue
      link.href = url.href
      const title = document.createElement('span')
      title.className = 'search-modal__result-title'
      appendHighlight(title, item.title, terms, helpers.highlight)
      const excerpt = document.createElement('p')
      excerpt.className = 'search-modal__excerpt'
      appendHighlight(excerpt, item.excerpt, terms, helpers.highlight)
      link.append(title, excerpt)
      if (item.tags) {
        const tags = document.createElement('span')
        tags.className = 'search-modal__tags'
        tags.textContent = item.tags.split(' ').map(tag => `# ${tag}`).join('  ')
        link.append(tags)
      }
      li.append(link)
      fragment.append(li)
    }
    list.replaceChildren(fragment)
    list.inert = false
    status.textContent = items.length ? messages.count.replace('{COUNT}', items.length) : messages.empty
  }

  async function runSearch(query, id) {
    try {
      const helpers = await ensureSearch()
      if (!helpers || id !== requestId || signal.aborted)
        return
      const items = await helpers.search(query)
      if (id !== requestId || signal.aborted)
        return
      results = items
      renderResults(items, query, helpers)
    }
    catch (error) {
      if (id === requestId && !signal.aborted) {
        list.replaceChildren()
        list.inert = false
        status.textContent = messages.unavailable
        console.warn('[Search] Failed to search:', error)
      }
    }
    finally {
      if (id === requestId)
        resultsArea.removeAttribute('aria-busy')
    }
  }

  function queueSearch() {
    clearTimeout(searchTimer)
    const id = ++requestId
    const query = input.value.trim()
    clear.hidden = !input.value
    results = []
    list.inert = true
    resultsArea.hidden = !query
    if (!query) {
      list.replaceChildren()
      list.inert = false
      status.textContent = ''
      resultsArea.removeAttribute('aria-busy')
      return
    }
    resultsArea.setAttribute('aria-busy', 'true')
    status.textContent = messages.loading
    searchTimer = setTimeout(() => void runSearch(query, id), 160)
  }

  input.addEventListener('input', (event) => {
    if (!event.isComposing)
      queueSearch()
  }, { signal })
  input.addEventListener('compositionend', queueSearch, { signal })
  clear.addEventListener('click', () => {
    input.value = ''
    queueSearch()
    focusInput()
  }, { signal })
  modal.querySelector('form').addEventListener('submit', (event) => {
    event.preventDefault()
    if (results.length)
      list.querySelector('a')?.click()
  }, { signal })

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element))
      return
    if (event.target.closest('[data-search-open]')) {
      event.preventDefault()
      openModal()
    }
    else if (event.target.closest('[data-search-close]')) {
      closeModal()
    }
  }, { signal })

  document.addEventListener('keydown', (event) => {
    if (event.isComposing)
      return
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault()
      if (isOpen())
        closeModal()
      else
        openModal()
      return
    }
    if (!isOpen())
      return
    if (event.key === 'Escape') {
      event.preventDefault()
      event.stopPropagation()
      closeModal()
      return
    }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      const links = Array.from(list.querySelectorAll('a'))
      if (links.length) {
        event.preventDefault()
        const current = links.indexOf(document.activeElement)
        const next = current + (event.key === 'ArrowDown' ? 1 : -1)
        if (next < 0)
          focusInput()
        else
          links[Math.min(next, links.length - 1)].focus()
      }
      return
    }
    if (event.key === 'Tab') {
      const focusable = Array.from(modal.querySelectorAll('a[href], button:not([hidden]), input:not([disabled])'))
        .filter(element => element.getClientRects().length > 0)
      const first = focusable[0] ?? dialog
      const last = focusable.at(-1) ?? dialog
      if (event.shiftKey && (document.activeElement === first || !modal.contains(document.activeElement))) {
        event.preventDefault()
        last.focus()
      }
      else if (!event.shiftKey && (document.activeElement === last || !modal.contains(document.activeElement))) {
        event.preventDefault()
        first.focus()
      }
    }
  }, { capture: true, signal })

  const preload = (event) => {
    if (event.target instanceof Element && event.target.closest('[data-search-open]')) {
      clearTimeout(preloadTimer)
      preloadTimer = setTimeout(() => {
        if (!signal.aborted)
          void ensureSearch()?.catch(() => {})
      }, 320)
    }
  }
  document.addEventListener('pointerover', preload, { passive: true, signal })
  document.addEventListener('focusin', preload, { signal })
  document.addEventListener('search-modal-open', openModal, { signal })

  globalThis.__blogSearchCleanup = () => {
    closeModal()
    clearTimeout(searchTimer)
    clearTimeout(preloadTimer)
    requestId++
    controller.abort()
  }
  document.addEventListener('astro:before-swap', globalThis.__blogSearchCleanup, { once: true, signal })
  if (autoOpen)
    openModal()
})()
</script>

<style is:global>
  .search-modal {
    --search-top: clamp(4.5rem, 20dvh, 11rem);
    --search-bottom: max(1rem, env(safe-area-inset-bottom));
    --search-input-height: 3.5rem;
    --search-surface: rgba(250, 250, 252, 0.48);
    --search-sheen: rgba(255, 255, 255, 0.32);
    --search-reflection: rgba(255, 255, 255, 0.045);
    --search-border: rgba(0, 0, 0, 0.075);
    --search-edge-top: rgba(255, 255, 255, 0.72);
    --search-edge-bottom: rgba(0, 0, 0, 0.045);
    --search-text: oklch(var(--un-preset-theme-colors-primary));
    --search-muted: oklch(var(--un-preset-theme-colors-secondary) / 0.9);
    --search-hover: rgba(0, 0, 0, 0.055);
    --search-shadow: 0 12px 32px rgba(0, 0, 0, 0.09), 0 2px 8px rgba(0, 0, 0, 0.04);
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--search-top) 1rem var(--search-bottom);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear var(--overlay-duration);
  }

  html.dark .search-modal {
    --search-surface: rgba(17, 19, 21, 0.38);
    --search-sheen: rgba(255, 255, 255, 0.045);
    --search-reflection: rgba(255, 255, 255, 0.008);
    --search-border: rgba(255, 255, 255, 0.075);
    --search-edge-top: rgba(255, 255, 255, 0.17);
    --search-edge-bottom: rgba(255, 255, 255, 0.035);
    --search-hover: rgba(255, 255, 255, 0.045);
    --search-shadow: 0 12px 32px rgba(0, 0, 0, 0.24), 0 2px 8px rgba(0, 0, 0, 0.14);
  }

  .search-modal[data-open='1'] {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay-backdrop-tint);
    backdrop-filter: blur(var(--overlay-backdrop-blur));
    -webkit-backdrop-filter: blur(var(--overlay-backdrop-blur));
    opacity: 0;
    transition: opacity var(--overlay-duration) var(--overlay-easing);
  }

  .search-modal[data-open='1'] .search-modal__backdrop {
    opacity: 1;
  }

  .search-modal__dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(34rem, 100%);
    max-height: calc(100dvh - var(--search-top) - var(--search-bottom));
    overflow: hidden;
    color: var(--search-text);
    background: linear-gradient(135deg, var(--search-sheen), transparent 42%, var(--search-reflection)), var(--search-surface);
    border: 1px solid var(--search-border);
    border-top-color: var(--search-edge-top);
    border-bottom-color: var(--search-edge-bottom);
    border-radius: 1.75rem;
    box-shadow: inset 0 1px 0 var(--search-sheen), var(--search-shadow);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    outline: none;
    opacity: 0;
    transform: translateY(-5px);
    transition:
      opacity var(--overlay-duration) var(--overlay-easing),
      transform var(--overlay-duration) var(--overlay-easing);
  }

  .search-modal[data-open='1'] .search-modal__dialog {
    opacity: 1;
    transform: translateY(0);
  }

  .search-modal__form {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    height: var(--search-input-height);
    padding: 0 1.1rem;
    gap: 0.8rem;
  }

  .search-modal__icon {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    color: var(--search-muted);
  }

  .search-modal__input {
    min-width: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--search-text);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    caret-color: var(--search-text);
    -webkit-appearance: none;
  }

  .search-modal__input::placeholder {
    color: var(--search-muted);
    opacity: 0.85;
  }

  .search-modal__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-modal__clear,
  .search-modal__close {
    display: grid;
    place-items: center;
    flex: none;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--search-muted);
    cursor: pointer;
  }

  .search-modal__clear {
    width: 1.5rem;
  }

  .search-modal__clear svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .search-modal__close kbd {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--search-border);
    border-radius: 0.3rem;
    font-size: 0.65rem;
    line-height: 1.2;
  }

  .search-modal__clear:hover,
  .search-modal__close:hover {
    color: var(--search-text);
  }

  .search-modal button:focus-visible {
    outline: 1px solid var(--search-muted);
    outline-offset: 3px;
    border-radius: 0.3rem;
  }

  .search-modal__results {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.1);
    padding: 0.4rem 0.55rem 0.55rem;
    scrollbar-width: thin;
    scrollbar-color: var(--search-border) transparent;
  }

  .search-modal__summary {
    padding: 0.25rem 0.8rem 0.65rem;
    color: var(--search-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .search-modal__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-modal__list li + li {
    margin-top: 0.2rem;
  }

  .search-modal__result {
    display: block;
    padding: 0.7rem;
    border-radius: 0.95rem;
    text-decoration: none;
    outline: none;
    transition: background-color 120ms ease-out;
  }

  .search-modal__result:hover,
  .search-modal__result:focus-visible {
    background: var(--search-hover);
  }

  .search-modal__result-title {
    display: block;
    color: var(--search-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .search-modal__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.35rem;
    color: var(--search-muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .search-modal mark {
    background: transparent;
    color: var(--search-text);
    font-weight: 600;
  }

  .search-modal__tags {
    display: block;
    margin-top: 0.45rem;
    color: var(--search-muted);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .search-modal [hidden] {
    display: none !important;
  }

  html.search-modal-open,
  html.search-modal-open body {
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .search-modal {
      --search-top: max(4rem, calc(env(safe-area-inset-top) + 2rem));
      --search-input-height: 3.25rem;
      padding-inline: 0.85rem;
    }

    .search-modal__dialog {
      border-radius: 1.625rem;
    }

    .search-modal__form {
      padding-inline: 1rem;
      gap: 0.65rem;
    }

    .search-modal__icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .search-modal__input {
      font-size: 1rem;
    }

    .search-modal__close {
      display: none;
    }
  }

  html.reduce-motion .search-modal,
  html.reduce-motion .search-modal__backdrop,
  html.reduce-motion .search-modal__dialog {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-modal,
    .search-modal__backdrop,
    .search-modal__dialog,
    .search-modal__result {
      transition: none;
    }
  }
</style>
