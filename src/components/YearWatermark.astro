---
import { themeConfig } from '@/config'

interface Props {
  year: number
  summary?: string
  showAge?: boolean
}

const { year, summary, showAge = true } = Astro.props
const { birthYear } = themeConfig.site
const age = showAge && birthYear && year >= birthYear ? `${year - birthYear} 岁` : ''
---

<header class:list={['year-heading', { 'recent-year': !showAge }]}>
  <h3 class="watermark">
    <span class="sr-only">{year} 年{age && `，${age}`}</span>
    <span class="year-faces" aria-hidden="true" data-can-flip={age ? '' : undefined}>
      <span class="year-front">{String(year).slice(0, -2)}<span class="year-ending">{String(year).slice(-2)}</span></span>
      {age && <span class="year-age">{age}</span>}
    </span>
  </h3>
  {summary && <span class="archive-year-stats" id={`archive-summary-${year}`}>{summary}</span>}
  {(age || summary) && (
    <button type="button" class="year-toggle" aria-pressed="false"
      aria-label={`${year} 年${age ? '年龄' : ''}${age && summary ? '与' : ''}${summary ? '年度统计' : ''}`}
      aria-describedby={summary ? `archive-summary-${year}` : undefined} />
  )}
</header>

<style>
  .year-heading {
    --year-size: clamp(5.5rem, 8vw, 6.5rem);
    position: relative;
    display: grid;
    grid-template-columns: var(--archive-columns, 1fr);
    column-gap: var(--archive-column-gap, 0);
    align-items: center;
    min-height: max(44px, calc(var(--year-size) * .45));
    line-height: 1;
  }
  .recent-year {
    --year-size: clamp(6.75rem, 10vw, 8.125rem);
  }
  .recent-year .watermark {
    inset-inline-start: -.045em;
    letter-spacing: -.035em;
    opacity: .2;
  }
  .recent-year .year-ending {
    padding-inline: .08em;
  }
  .watermark {
    position: absolute;
    inset: 0 auto auto 0;
    margin: 0;
    font: 700 var(--year-size)/1 var(--font-mono);
    letter-spacing: .001em;
    font-variant-numeric: tabular-nums;
    color: oklch(var(--un-preset-theme-colors-secondary));
    opacity: .26;
    pointer-events: none;
    user-select: none;
  }
  @supports (-webkit-text-stroke: 1px black) {
    .watermark {
      color: transparent;
      -webkit-text-stroke: 1.5px oklch(var(--un-preset-theme-colors-secondary));
    }
  }
  .year-faces {
    display: inline-grid;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) var(--motion-ease-standard);
  }
  .year-faces[data-can-flip] {
    transform: rotateX(var(--year-rotation, 0deg));
  }
  .year-front, .year-age {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    white-space: nowrap;
  }
  .year-age {
    align-self: center;
    font-size: .86em;
    transform: rotateX(180deg);
  }
  .year-ending {
    display: inline-block;
    padding-inline: .17em .2em;
    mask-image: var(--cut-start), var(--cut-end);
    mask-composite: intersect;
    background: oklch(var(--un-preset-theme-colors-secondary) / .65);
    color: oklch(var(--un-preset-theme-colors-background));
    -webkit-text-stroke-width: 0;
  }
  .archive-year-stats {
    grid-column: 3;
    color: oklch(var(--un-preset-theme-colors-secondary));
    font: var(--label-size)/1 var(--font-mono);
    letter-spacing: .02em;
    opacity: var(--year-stats-opacity, 0);
    transition: opacity var(--motion-base) var(--motion-ease-standard);
  }
  .year-toggle {
    display: none;
  }
  @media (max-width: 768px) {
    .year-heading {
      --year-size: clamp(4.75rem, 19vw, 5.5rem);
      display: flex;
      justify-content: flex-end;
    }
    .recent-year {
      --year-size: clamp(5.25rem, 22vw, 6.75rem);
    }
    :global([data-archive-bound='1']) .year-toggle {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      cursor: pointer;
      background: transparent;
      border: 0;
    }
    .year-toggle:focus-visible {
      outline: 1px solid currentColor;
      outline-offset: -1px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .year-faces, .archive-year-stats { transition: none; }
  }
  :global(html.reduce-motion) :is(.year-faces, .archive-year-stats) { transition: none; }
</style>
