---
import { getPostStatusLabel } from '@/utils/content'

interface Props {
  status?: 'idea' | 'ongoing' | 'paused' | 'completed'
}

const { status } = Astro.props
const label = getPostStatusLabel(status)
---

{label && (
  <span
    class="status-badge inline-flex shrink-0 items-center whitespace-nowrap align-middle leading-none font-navbar"
    data-status={status}
    role="img"
    aria-label={`状态：${label}`}
    tabindex="0"
  >
    <span class="status-hint" aria-hidden="true">{label}</span>
  </span>
)}

<style>
  .status-badge {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: oklch(var(--un-preset-theme-colors-secondary));
    position: relative;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    cursor: help;
  }

  .status-hint {
    position: absolute;
    z-index: 2;
    padding: .2rem .3rem;
    background: oklch(var(--un-preset-theme-colors-background));
    inset-inline-start: 100%;
    display: none;
  }

  .status-badge:focus .status-hint {
    display: block;
  }

  @media (hover: hover) {
    .status-badge:hover .status-hint {
      display: block;
    }
  }

  .status-badge:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -2px;
  }
  .status-badge::before {
    flex: none;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--status-dot);
    content: '';
  }

  .status-badge[data-status='idea'] {
    --status-dot: rgb(217 119 6 / 0.8);
  }

  .status-badge[data-status='ongoing'] {
    --status-dot: rgb(2 132 199 / 0.8);
  }

  .status-badge[data-status='paused'] {
    --status-dot: rgb(113 113 122 / 0.7);
  }

  .status-badge[data-status='completed'] {
    --status-dot: var(--status-success);
  }

  :global(html.dark) .status-badge[data-status='idea'] {
    --status-dot: rgb(252 211 77 / 0.75);
  }

  :global(html.dark) .status-badge[data-status='ongoing'] {
    --status-dot: rgb(125 211 252 / 0.75);
  }

  :global(html.dark) .status-badge[data-status='paused'] {
    --status-dot: rgb(161 161 170 / 0.6);
  }

</style>

<script>
  document.addEventListener('pointerup', (event) => {
    if (event.pointerType !== 'touch' || !(event.target instanceof Element))
      return
    const badge = event.target.closest<HTMLElement>('.status-badge')
    if (badge)
      badge.focus({ preventScroll: true })
    else if (document.activeElement instanceof HTMLElement && document.activeElement.matches('.status-badge'))
      document.activeElement.blur()
  })
</script>
