---
import { getPostStatusLabel } from '@/utils/content'

interface Props {
  status?: 'idea' | 'ongoing' | 'paused' | 'completed'
  compact?: boolean
  className?: string
}

const { status, compact = false, className = '' } = Astro.props
const label = getPostStatusLabel(status)
---

{label && (
  <span
    class:list={[
      'status-badge inline-flex shrink-0 items-center whitespace-nowrap align-middle leading-none font-navbar',
      compact && 'status-badge--compact',
      className,
    ]}
    data-status={status}
  >
    {label}
  </span>
)}

<style>
  /* 状态不是控件：一个小圆点 + 灰字，颜色只留在点上 */
  .status-badge {
    gap: 0.42em;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.62);
  }

  .status-badge--compact {
    font-size: 0.71rem;
  }

  .status-badge::before {
    flex: none;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--status-dot);
    content: '';
  }

  .status-badge[data-status='idea'] {
    --status-dot: rgb(217 119 6 / 0.8);
  }

  .status-badge[data-status='ongoing'] {
    --status-dot: rgb(2 132 199 / 0.8);
  }

  .status-badge[data-status='paused'] {
    --status-dot: rgb(113 113 122 / 0.7);
  }

  .status-badge[data-status='completed'] {
    --status-dot: rgb(5 150 105 / 0.8);
  }

  :global(html.dark) .status-badge[data-status='idea'] {
    --status-dot: rgb(252 211 77 / 0.75);
  }

  :global(html.dark) .status-badge[data-status='ongoing'] {
    --status-dot: rgb(125 211 252 / 0.75);
  }

  :global(html.dark) .status-badge[data-status='paused'] {
    --status-dot: rgb(161 161 170 / 0.6);
  }

  :global(html.dark) .status-badge[data-status='completed'] {
    --status-dot: rgb(110 231 183 / 0.75);
  }
</style>
