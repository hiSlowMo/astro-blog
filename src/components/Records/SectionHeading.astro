---
interface Props {
  /** Section number on the page, e.g. 01 */
  no: string
  title: string
  english: string
  id: string
}

const { no, title, english, id } = Astro.props
---

<div class="records-heading">
  <h2 class="section-label" id={id}>
    {title}
    <small lang="en">{no} <span aria-hidden="true">/</span> {english}</small>
  </h2>
  {Astro.slots.has('default') && (
    <div class="records-heading__aside">
      <slot />
    </div>
  )}
</div>

<style>
  .records-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.125rem;
    margin-bottom: clamp(1rem, 2vw, 1.35rem);
  }

  .section-label {
    scroll-margin-top: 1.5rem;
  }

  .records-heading__aside {
    margin-left: auto;
  }

  .records-heading__aside :global(.rec-label) {
    color: var(--rec-ink-2);
    white-space: nowrap;
  }
</style>
