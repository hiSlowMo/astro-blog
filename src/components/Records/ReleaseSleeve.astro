---
import { createHash } from 'node:crypto'
import { formatPostDate } from '@/utils/date'

interface Props {
  postId: string
  published: Date
}

const { postId, published } = Astro.props
const [palette, horizontal, vertical] = createHash('sha256').update(postId).digest()
const labelColors = ['#a9bcad', '#d6ba99', '#aabac5', '#c5b4b9', '#cccaab']
const catalogue = formatPostDate(published, 'YYYY-MM-DD').replaceAll('-', '')
---

<svg viewBox="0 0 160 160" width="160" height="160" aria-hidden="true" focusable="false">
  <rect width="160" height="160" fill="#e6e1d5" />
  <g transform={`translate(${132 + horizontal % 16} ${104 + vertical % 16})`}>
    <circle r="92" fill="#20211f" />
    <g fill="none" stroke="#555650" stroke-width=".75">
      {[34, 39, 41, 47, 52, 58, 60, 66, 72, 77, 79, 85, 89].map(radius => <circle r={radius} />)}
    </g>
    <circle r="28" fill={labelColors[palette % labelColors.length]} />
    <circle r="2.5" fill="#20211f" />
  </g>
  <g fill="#262723" font-family="var(--font-sans), sans-serif" font-size="12" font-weight="700" letter-spacing="-.5">
    <text x="10" y="19">THE</text>
    <text x="10" y="31">SLOWMO</text>
    <text x="10" y="43">RECORDS</text>
  </g>
  <text x="10" y="57" fill="#555650" font-family="var(--font-mono), monospace" font-size="7">{catalogue}</text>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
</style>
