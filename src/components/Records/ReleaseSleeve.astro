---
import { releaseSleeveArtwork } from '@/utils/release-sleeve'

interface Props {
  title: string
  published: Date
}

const { title, published } = Astro.props
---

<svg viewBox="0 0 160 160" width="160" height="160" aria-hidden="true" focusable="false" set:html={releaseSleeveArtwork(title, published)} />

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
  svg :global(.sleeve-wordmark) { font-family: var(--font-sans), sans-serif; }
  svg :global(.sleeve-date) { font-family: var(--font-mono), monospace; }
</style>
