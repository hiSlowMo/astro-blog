---
import type { Language } from '@/i18n/config'
import Button from '@/components/Button.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Navbar from '@/components/Navbar.astro'
import SearchModal from '@/components/SearchModal.astro'
import AsciiSky from '@/components/Widgets/AsciiSky.astro'
import CodeCopyButton from '@/components/Widgets/CodeCopyButton.astro'
import GithubCard from '@/components/Widgets/GithubCard.astro'
import ImageZoom from '@/components/Widgets/ImageZoom.astro'
import MediaEmbed from '@/components/Widgets/MediaEmbed.astro'
import SoundEffect from '@/components/Widgets/SoundEffect.astro'
import { themeConfig } from '@/config'
import Head from '@/layouts/Head.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/extension.css'
import '@/styles/global.css'
import '@/styles/lqip.css'
import '@/styles/markdown.css'
import '@/styles/transition.css'
import '@/styles/reading.css'

interface Props {
  pageTitle?: string
  pageDescription?: string
  postTitle?: string
  postDescription?: string
  postSlug?: string
  article?: { published: Date, updated?: Date, tags: string[] }
  supportedLangs?: Language[]
  enableContentEnhancements?: boolean
  enableKatex?: boolean
}

const {
  pageTitle,
  pageDescription,
  postTitle,
  postDescription,
  postSlug,
  article,
  supportedLangs = [],
  enableContentEnhancements = false,
  enableKatex = false,
} = Astro.props
const { isPost, isSearch, isMoments, isAbout, isArchive, isTag, isLinks } = getPageInfo(Astro.url.pathname)
// Each section of the site gets its own sky, the rest share the clouds
const skyScenes = [
  [isMoments, 'rain'],
  [isAbout, 'stars'],
  [isArchive, 'world'],
  [isTag, 'contour'],
  [isLinks, 'fireflies'],
  [isPost, 'haze'],
] as const
const skyScene = skyScenes.find(([matches]) => matches)?.[1] ?? 'clouds'
const fontStyle = themeConfig.global.fontStyle === 'serif' ? 'font-serif' : 'font-sans'
const MarginBottom = isPost && themeConfig.comment.enabled
  ? 'mb-10' // Post page with comment
  : 'mb-12' // Other pages without comment
---

<html
  lang={Astro.currentLocale}
  data-reading-layout={isPost ? 'article' : undefined}
  class:list={[
    fontStyle,
    isPost ? 'scroll-smooth' : '',
  ]}
>
  <Head {pageTitle} {pageDescription} {postTitle} {postDescription} {postSlug} {article} {enableKatex} />
  <body data-pagefind-ignore={isPost ? undefined : 'all'}>
    <AsciiSky scene={skyScene} />
    <div
      class="site-layout mx-auto max-w-205.848 min-h-vh w-full min-h-dvh sm:(max-w-45rem px-10 py-10)"
      p="x-[min(6vw,1.35rem)] y-7"
      lg="mx-[max(5.75rem,calc(50vw-34.25rem))] my-20 max-w-[min(calc(75vw-16rem),44rem)] min-h-full p-0"
    >
      <div class="site-header-row">
        <Header />
        {!isPost && <Button supportedLangs={supportedLangs} />}
      </div>
      <Navbar />
      <main
        class={MarginBottom}
        data-pagefind-body={isPost ? '' : undefined}
      >
        <slot />
      </main>
      <Footer />
    </div>
    {isPost && <Button supportedLangs={supportedLangs} />}
    <SoundEffect />
    {enableContentEnhancements && <CodeCopyButton />}
    {enableContentEnhancements && <GithubCard />}
    {enableContentEnhancements && <MediaEmbed />}
    {enableContentEnhancements && <ImageZoom />}
    <SearchModal autoOpen={isSearch} />
  </body>
</html>

<script>
  import '@/scripts/reading-layout'
</script>

<style>
  .site-header-row { display: contents; }
  @media (max-width: 1023.98px) {
    .site-header-row:has(.site-utility--single) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      margin-bottom: clamp(1.4rem, 4vw, 2rem);
    }
    .site-header-row:has(.site-utility--single) :global(#site-header) {
      grid-area: 1 / 1 / 2 / -1;
      margin-bottom: 0;
    }
    .site-header-row :global(#site-utility.site-utility--single) {
      position: static;
      grid-area: 1 / 2;
      align-self: end;
      margin-bottom: -.625rem;
    }
    .site-layout {
      --page-gutter: min(6vw, 1.35rem);
      padding-left: max(var(--page-gutter), env(safe-area-inset-left));
      padding-right: max(var(--page-gutter), env(safe-area-inset-right));
      padding-top: max(var(--page-gutter), env(safe-area-inset-top), 1.75rem);
      padding-bottom: calc(var(--controls-bottom) + 3.75rem);
    }
    :global(html:has(.site-layout)) {
      scroll-padding-bottom: calc(var(--controls-bottom) + 3rem);
    }
  }
  @media (min-width: 640px) {
    .site-layout { --page-gutter: 2.5rem; }
  }
</style>
