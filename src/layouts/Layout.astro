---
import type { Language } from '@/i18n/config'
import Button from '@/components/Button.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Navbar from '@/components/Navbar.astro'
import SearchModal from '@/components/SearchModal.astro'
import AsciiSky from '@/components/Widgets/AsciiSky.astro'
import CodeCopyButton from '@/components/Widgets/CodeCopyButton.astro'
import GithubCard from '@/components/Widgets/GithubCard.astro'
import ImageZoom from '@/components/Widgets/ImageZoom.astro'
import MediaEmbed from '@/components/Widgets/MediaEmbed.astro'
import SoundEffect from '@/components/Widgets/SoundEffect.astro'
import { themeConfig } from '@/config'
import Head from '@/layouts/Head.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/extension.css'
import '@/styles/font.css'
import '@/styles/global.css'
import '@/styles/lqip.css'
import '@/styles/markdown.css'
import '@/styles/transition.css'

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
  supportedLangs?: Language[]
  enableContentEnhancements?: boolean
}

const {
  postTitle,
  postDescription,
  postSlug,
  supportedLangs = [],
  enableContentEnhancements = false,
} = Astro.props
const { isPost, isSearch, isMoments, isAbout, isArchive, isTag, isLinks } = getPageInfo(Astro.url.pathname)
// Each section of the site gets its own sky, the rest share the clouds
const skyScenes = [
  [isMoments, 'rain'],
  [isAbout, 'stars'],
  [isArchive, 'world'],
  [isTag, 'contour'],
  [isLinks, 'fireflies'],
  [isPost, 'haze'],
] as const
const skyScene = skyScenes.find(([matches]) => matches)?.[1] ?? 'clouds'
const fontStyle = themeConfig.global.fontStyle === 'serif' ? 'font-serif' : 'font-sans'
const MarginBottom = isPost && themeConfig.comment.enabled
  ? 'mb-10' // Post page with comment
  : 'mb-12' // Other pages without comment
---

<html
  lang={Astro.currentLocale}
  class:list={[
    fontStyle,
    isPost ? 'scroll-smooth' : '',
  ]}
>
  <Head {postTitle} {postDescription} {postSlug} />
  <body data-pagefind-ignore={isPost ? undefined : 'all'}>
    <AsciiSky scene={skyScene} />
    <div
      class="mx-auto max-w-205.848 min-h-vh w-full min-h-dvh sm:(max-w-45rem px-10 py-10)"
      p="x-[min(6vw,1.35rem)] y-7"
      lg="mx-[max(5.75rem,calc(50vw-34.25rem))] my-20 max-w-[min(calc(75vw-16rem),44rem)] min-h-full p-0"
    >
      <Header />
      <Navbar />
      <main
        class={MarginBottom}
        data-pagefind-body={isPost ? '' : undefined}
      >
        <slot />
      </main>
      <Footer />
    </div>
    <Button supportedLangs={supportedLangs} />
    <SoundEffect />
    {enableContentEnhancements && <CodeCopyButton />}
    {enableContentEnhancements && <GithubCard />}
    {enableContentEnhancements && <MediaEmbed />}
    {enableContentEnhancements && <ImageZoom />}
    <SearchModal autoOpen={isSearch} />
  </body>
</html>
